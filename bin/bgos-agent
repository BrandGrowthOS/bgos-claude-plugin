#!/usr/bin/env bash
# =============================================================================
# hoai-agent, installer + always-on supervisor for a BGOS Claude Code agent.
#
# One command to set up (and optionally keep alive forever) a Claude Code agent
# that talks to the BGOS app via the bgos channel plugin. It packages the recipe
# a human would otherwise do by hand:
#
#   • ensure the plugin is cloned + `bun install`ed
#   • write the agent's .mcp.json (BGOS creds) + a CLAUDE.md stub
#   • (with --always-on) install a per-agent service, launchd on macOS,
#     systemd --user on Linux, that restarts the agent on crash / quit / logout /
#     reboot, with crash-loop detection so a wedged agent is visible, not
#     silently churning. Supervisor generation 2 (design section 4): the service
#     runs <statedir>/run.sh, which starts hoai (bin/hoai-core.mjs, from the
#     CURRENT plugin root, resolved at every launch) with HOAI_SUPERVISED=1
#     inside a detached tmux session on the agent's own socket. hoai owns the
#     launch: the agent's pinned session (resumed, never a fresh one: finding 7),
#     the startup gates under expect, launch.json and supervisor.json. tmux keeps
#     remote /compact working (finding 8: lib/compact-inject.ts types into the
#     session named by BGOS_TMUX_SESSION).
#
# Per-agent and keyed by assistant id, so one host can run several. Auditable on
# purpose: plain bash, no runtime deps beyond what the agent already needs
# (bun, claude, git, expect, node; tmux optional).
#
# Usage:
#   hoai-agent pair <CODE> [--backend <url>]   (recommended: no raw API key)
#   hoai-agent install --assistant <id> [--key <k> --user <u>] [--always-on] [opts]
#   hoai-agent status   [--assistant <id>]
#   hoai-agent start | stop | restart | logs | attach | uninstall --assistant <id>
#   hoai-agent link
#   hoai-agent help
# =============================================================================
set -euo pipefail

VERSION="0.2.0"
DEFAULT_BACKEND="https://api.brandgrowthos.ai/api/v1"

# --- the channel spec, and why it is a constant here -------------------------
# `server:<name>` is how Claude Code names a channel that comes from an MCP
# SERVER ENTRY; `plugin:<plugin>@<marketplace>` names one that comes from a
# marketplace plugin. Handing a session the wrong one connects nothing and
# drops every inbound message in silence (2026-08-21), so the choice matters.
#
# This script does not have to GUESS which world it is in, because it
# guarantees the answer. cmd_install refuses to continue unless the workspace
# has a .mcp.json (it writes one from --key/--user, or uses an existing one, or
# dies), every .mcp.json this repo writes names its MCP server `bgos`
# (write_mcp_json below, bin/bgos-claim.mjs buildMcpJson, bin/hoai-bootstrap.sh,
# bin/hoai-bootstrap.ps1, .mcp.json.example), and both supervisors run claude
# with WorkingDirectory set to that workspace. So the session this script
# launches loads THAT server, and `server:bgos` is correct by construction.
#
# DO NOT "fix" this to bin/bgos-install-method.mjs detectInstallMethod().
# Detection answers a DIFFERENT question, where the plugin FILES live. On a host
# that also has a marketplace HOAI install it answers `marketplace`, which would
# bake `plugin:hoai@hoai` into the supervisor while the workspace publishes `bgos`:
# a permanently deaf agent held up forever by launchd or systemd. That is the
# 2026-08-21 failure signature, pointed the other way.
#
# THE SECOND WORLD (2026-09-22): a PAIRED MARKETPLACE folder has no .mcp.json at
# all. Desktop one-click installs the marketplace plugin and pairs with a one
# time code, so it never holds a key to write a .mcp.json with, and the old
# rule ("no .mcp.json, die") made its launch step impossible on a fresh
# workspace (measured: "no .mcp.json ... and no creds given", exit 1). That gate
# is NOT simply skipped. With no .mcp.json the supervisor is installed only when
# the paired topology is PROVEN: the folder pin names this agent, its per-agent
# credentials are there, and the marketplace plugin is installed where the
# background session will look. The proof is `bgos-doctor --prove-paired-topology`,
# which composes pairing's own live-safe verifier with the SAME route resolver
# hoai launches through, so this script still never types the marketplace spec
# and still never runs detection itself: it takes the spec the resolver proved,
# or it refuses with a named reason. A deaf agent is worse than a refused
# install. A workspace that DOES carry a .mcp.json is untouched by any of this.
# The name is spelled once (MCP_SERVER_NAME) so test/bgos-agent.static.test.ts
# can pin the two halves of that invariant against each other and against
# CLONE_CHANNEL_SPEC in bin/bgos-install-method.mjs. Use --channel only for a
# workspace whose .mcp.json names its server something else.
MCP_SERVER_NAME="bgos"
DEFAULT_CHANNEL="server:$MCP_SERVER_NAME"

# --- resolve self + plugin root (bin/bgos-agent -> repo root) ----------------
SOURCE="${BASH_SOURCE[0]:-$0}"
while [ -h "$SOURCE" ]; do                      # follow symlinks (e.g. ~/.local/bin)
  DIR="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)"
  SOURCE="$(readlink "$SOURCE")"
  [[ "$SOURCE" != /* ]] && SOURCE="$DIR/$SOURCE"
done
SELF="$(cd -P "$(dirname "$SOURCE")" >/dev/null 2>&1 && pwd)/$(basename "$SOURCE")"
BIN_DIR="$(dirname "$SELF")"
PLUGIN_DIR="${BGOS_PLUGIN_DIR:-$(cd "$BIN_DIR/.." >/dev/null 2>&1 && pwd)}"
PLUGIN_REPO="https://github.com/BrandGrowthOS/bgos-claude-plugin.git"
STATE_ROOT="$HOME/.bgos-agent"
WRAPPER_PATH="$STATE_ROOT/runtime/bgos-daemon-wrapper.mjs"
OS="$(uname -s)"

# --- pretty output -----------------------------------------------------------
if [ -t 1 ]; then
  B=$'\033[1m'; R=$'\033[31m'; G=$'\033[32m'; Y=$'\033[33m'; Z=$'\033[0m'
else B=""; R=""; G=""; Y=""; Z=""; fi
info() { printf '%s▸%s %s\n' "$B" "$Z" "$*"; }
ok()   { printf '%s✓%s %s\n' "$G" "$Z" "$*"; }
warn() { printf '%s!%s %s\n' "$Y" "$Z" "$*" >&2; }
die()  { printf '%s✗%s %s\n' "$R" "$Z" "$*" >&2; exit 1; }

# --- per-agent path helpers --------------------------------------------------
# State (supervisor artifacts: run.sh, logs, launch-status) and the default
# workspace are SIBLINGS, so uninstall can wipe state without touching user data.
# The state dir is also hoai's (~/.bgos-agent/<id>): the session pin lives there,
# and uninstall keeps it (finding 7).
#
# Every name an agent's service is known by carries the HOME it was installed
# from (board row d6198bb6), as the per-machine watcher's does since #237:
# home-<hid>, the first 8 hex of the SHA-256 of the normalized HOME, computed by
# the SAME code the watcher uses (bin/hoai-agent-service.mjs home-id, on bun or
# node; lib/agent-inventory.mjs agentServiceNames mirrors these names). The
# launchd domain (gui/<uid>), the systemd --user manager and the tmux socket
# directory are one per user ACCOUNT, so a name with the agent id alone let an
# install, stop or uninstall from a scratch or second HOME holding the same
# agent's credentials boot out, restart or stop the owner's real agent. The OLD
# names (before 0.69.4) are legacy_*: an agent not renamed yet is still
# found and supervised under them, and the next install from the same HOME
# renames it in place. Before acting on either name, the registration is read
# back (hoai-agent-service.mjs probe, #237's reader): one that records another
# HOME, or none readable, is refused and left exactly as it is.
HOME_ID=""
label_for()    { printf 'ai.bgos.agent.%s.home-%s' "$1" "$HOME_ID"; }
unit_for()     { printf 'bgos-agent-%s-home-%s' "$1" "$HOME_ID"; }
plist_for()    { printf '%s/Library/LaunchAgents/%s.plist' "$HOME" "$(label_for "$1")"; }
unitfile_for() { printf '%s/.config/systemd/user/%s.service' "$HOME" "$(unit_for "$1")"; }
legacy_label_for()    { printf 'ai.bgos.agent.%s' "$1"; }
legacy_unit_for()     { printf 'bgos-agent-%s' "$1"; }
legacy_plist_for()    { printf '%s/Library/LaunchAgents/%s.plist' "$HOME" "$(legacy_label_for "$1")"; }
legacy_unitfile_for() { printf '%s/.config/systemd/user/%s.service' "$HOME" "$(legacy_unit_for "$1")"; }
statedir_for() { printf '%s/%s' "$STATE_ROOT" "$1"; }
# The agent's OWN tmux socket and session name (design section 4): a dedicated
# server per agent, so the session never lands in someone else's tmux server and
# stopping the agent can end exactly this server and nothing else. One socket
# directory per account (/tmp/tmux-<uid>), so it carries the HOME id too.
tmux_name_for() { printf 'hoai-%s-home-%s' "$1" "$HOME_ID"; }
legacy_tmux_name_for() { printf 'hoai-%s' "$1"; }
legacy_service_file_for() { # $1 id
  case "$OS" in
    Darwin) legacy_plist_for "$1" ;;
    Linux)  legacy_unitfile_for "$1" ;;
  esac
}
# The installed service file of this HOME for an agent: its own name's, else the
# OLD one's (an agent not renamed yet); nothing when neither exists.
service_file_for() { # $1 id
  local own old
  case "$OS" in
    Darwin) own="$(plist_for "$1")"; old="$(legacy_plist_for "$1")" ;;
    Linux)  own="$(unitfile_for "$1")"; old="$(legacy_unitfile_for "$1")" ;;
    *)      return 0 ;;
  esac
  if [ -n "$HOME_ID" ] && [ -f "$own" ]; then printf '%s' "$own"; return 0; fi
  if [ -z "$HOME_ID" ]; then
    # No HOME id: a renamed agent's file is still found (its name carries some home-<hid>), so the
    # caller can say it was not acted on rather than miss it.
    local f
    for f in "${own%-home-*}"-home-*.service "${own%.home-*}".home-*.plist; do
      if [ -f "$f" ]; then printf '%s' "$f"; return 0; fi
    done
  fi
  if [ -f "$old" ]; then printf '%s' "$old"; fi
}

# The shared helper (bin/hoai-agent-service.mjs) on bun, this script's runtime,
# or node: the first that answers. Nothing printed is no answer.
AGENT_SERVICE_JS="$PLUGIN_DIR/bin/hoai-agent-service.mjs"
agent_service_js() {
  local rt out
  for rt in bun node; do
    command -v "$rt" >/dev/null 2>&1 || continue
    out="$("$rt" "$AGENT_SERVICE_JS" "$@" 2>/dev/null)" || continue
    [ -n "$out" ] || continue
    printf '%s\n' "$out"
    return 0
  done
  return 1
}
# Sets HOME_ID; 1 when it cannot be computed (no bun or node answers).
compute_home_id() {
  [ -n "$HOME_ID" ] && return 0
  local out
  out="$(agent_service_js home-id --os "$OS" | head -n 1)" || out=""
  [[ "$out" =~ ^[0-9a-f]{8}$ ]] || return 1
  HOME_ID="$out"
}
need_home_id() {
  compute_home_id && return 0
  die "service-name:home-id-unavailable this agent's service is named after the HOME it is installed from, and the HOME id could not be computed ($AGENT_SERVICE_JS runs on bun or node, and neither answered). Install bun or Node.js 18 or newer, then run this again."
}
# Read one of this agent's registrations back (read only): sets PROBE_STATE
# (own, absent, foreign or unknown), PROBE_HOME, PROBE_ACTIVE (1/0) and
# PROBE_SAY (the refusal of this HOME's name, or why the old one is left
# alone). Unknown, never acted on, when the read-back itself cannot run.
probe_service() { # $1 id $2 own|legacy
  PROBE_STATE="unknown"; PROBE_HOME=""; PROBE_ACTIVE="0"
  PROBE_SAY="the registration could not be read back ($AGENT_SERVICE_JS runs on bun or node, and neither answered); nothing was changed"
  local out line
  out="$(agent_service_js probe --assistant "$1" --which "$2" --os "$OS" --uid "$(id -u)")" || return 0
  while IFS= read -r line; do
    case "$line" in
      state=*)  PROBE_STATE="${line#state=}" ;;
      home=*)   PROBE_HOME="${line#home=}" ;;
      active=*) PROBE_ACTIVE="${line#active=}" ;;
      say=*)    PROBE_SAY="${line#say=}" ;;
    esac
  done <<< "$out"
}
# A sentence about a registration this command left alone or renamed: on
# stderr, with a fixed prefix the daemon and the watcher log it by.
service_note() { printf '%s!%s service note: %s\n' "$Y" "$Z" "$*" >&2; }
# Which of this agent's two names a start, stop or restart acts on, read back
# first: this HOME's own name when it is this HOME's (own) or not loaded at all
# (none), else the OLD name when it is proven this HOME's (legacy). This HOME's
# own name recording another HOME is refused: with mode die the command dies
# with the refusal, with mode warn it says so and returns 1. An old name another
# HOME installed is left alone and said.
SVC_TARGET=""
resolve_target() { # $1 id $2 die|warn
  need_home_id
  probe_service "$1" own
  case "$PROBE_STATE" in
    own) SVC_TARGET=own; return 0 ;;
    foreign|unknown)
      if [ "${2:-die}" = die ]; then die "$PROBE_SAY"; fi
      warn "$PROBE_SAY"; return 1 ;;
  esac
  probe_service "$1" legacy
  case "$PROBE_STATE" in
    own)    SVC_TARGET=legacy ;;
    absent) SVC_TARGET=none ;;
    *)      service_note "$PROBE_SAY"; SVC_TARGET=none ;;
  esac
  return 0
}
# Does this service file record THIS HOME (plist HOME key, or the unit's HOME=)?
# Read by the shared helper (round 2): by real path, so a HOME spelled through a
# symlink is this HOME, and in any layout plutil may have rewritten a plist to.
# No answer is not recorded: nothing is removed on a guess.
file_records_home() { # $1 file
  [ -f "$1" ] || return 1
  local out
  out="$(agent_service_js records-home --file "$1" --os "$OS" | head -n 1)" || return 1
  [ "$out" = yes ]
}
# The generation of supervisor this script installs. A canonical supervisor with
# no stamp is generation 1 (run.expect, a fresh session, no tmux), which the
# watcher's keep-alive sweep upgrades at a safe moment (design section 5).
SUPERVISOR_GENERATION=2
default_workdir_for() { printf '%s/%s-workspace' "$STATE_ROOT" "$1"; }

# --- one install per agent at a time -------------------------------------------
# The agent's own daemon (reconcileAlwaysOn) and the watcher's keep-alive sweep
# can both decide, within the same minute, that this agent needs an install. Two
# installs at once write one run.sh and one service file twice and reload the
# service twice, and nobody can read afterwards which one won. So an install
# takes a per-agent lock first: mkdir is atomic, the second one finds the
# directory there and stands down (exit 0, nothing written; the first install
# is already doing what it asked for). The lock sits BESIDE the state dir, not
# in it, so uninstall's state wipe never touches another install's lock and no
# reader of ~/.bgos-agent mistakes it for an agent (it is not all digits). A
# lock is stale only when it is older than INSTALL_LOCK_STALE_MIN minutes AND
# the install that took it is gone (install_lock_stale): one that died without
# its trap (SIGKILL, a power cut). An install still running keeps its lock
# however long it takes.
INSTALL_LOCK_STALE_MIN=10
# How long an uninstall waits for an install of the same agent (cmd_uninstall).
UNINSTALL_LOCK_WAIT_S=30
INSTALL_LOCK=""
install_lock_for() { printf '%s.install.lock' "$(statedir_for "$1")"; }
release_install_lock() {
  if [ -n "$INSTALL_LOCK" ]; then rm -rf "$INSTALL_LOCK"; fi
  INSTALL_LOCK=""
}
# The start time of pid $1 as ps prints it (LC_ALL=C: one spelling in every
# locale), whitespace squeezed; nothing when ps cannot say (the pid is gone).
proc_started() { LC_ALL=C ps -o lstart= -p "$1" 2>/dev/null | awk 'NF { $1 = $1; print; exit }'; }
# 0 when the lock at $1 may be taken over. The holder is named in $1/pid by its
# pid AND that pid's start time: a pid alone is reused (after a reboot above
# all) and would hold the lock for an unrelated process forever, and age alone
# took the lock from an install that was merely slow (a hung git clone is
# still an install in progress). A pid file without a start time (an install
# from before it was recorded) or no ps to ask: age alone, as before.
install_lock_stale() { # $1 lock dir
  [ -n "$(find "$1" -maxdepth 0 -mmin +"$INSTALL_LOCK_STALE_MIN" 2>/dev/null)" ] || return 1
  local pid="" started="" now=""
  { read -r pid; read -r started; } 2>/dev/null < "$1/pid" || true
  if [[ "$pid" =~ ^[0-9]+$ ]] && [ -n "$started" ]; then
    now="$(proc_started "$pid")"
    [ -n "$now" ] && [ "$now" = "$started" ] && return 1
  fi
  return 0
}
acquire_install_lock() { # $1 assistant id -> 0 when this process now holds the lock, 1 when another install does
  local lock; lock="$(install_lock_for "$1")"
  mkdir -p "$STATE_ROOT"
  if ! mkdir "$lock" 2>/dev/null; then
    install_lock_stale "$lock" || return 1
    # Taking a stale lock over is check-then-act, so it is serialized: mkdir of
    # <lock>.takeover is atomic, and UNDER it the lock is judged stale again. A
    # contender that judged the old lock stale and was then held up would
    # otherwise remove the FRESH lock another one had just taken, and both
    # would install at once. A takeover takes milliseconds: a marker older than
    # a minute was left by a contender killed in the middle of one, and is
    # cleared (this attempt stands down, the next one proceeds).
    if ! mkdir "$lock.takeover" 2>/dev/null; then
      if [ -n "$(find "$lock.takeover" -maxdepth 0 -mmin +1 2>/dev/null)" ]; then rm -rf "$lock.takeover"; fi
      return 1
    fi
    local took=1
    if install_lock_stale "$lock"; then
      warn "removing a stale install lock for agent $1 (older than $INSTALL_LOCK_STALE_MIN minutes, and the install that took it is gone): $lock"
      rm -rf "$lock"
      if mkdir "$lock" 2>/dev/null; then took=0; fi
    fi
    rmdir "$lock.takeover" 2>/dev/null || true
    [ "$took" = 0 ] || return 1
  fi
  INSTALL_LOCK="$lock"
  # EXIT runs on a normal end, on every die, and when bash is ended by a signal.
  trap release_install_lock EXIT
  { printf '%s\n' "$$"; proc_started "$$"; } > "$lock/pid" 2>/dev/null || true
  return 0
}

# --- validators (everything user-supplied that lands in a generated file) ----
valid_id()      { [[ "$1" =~ ^[0-9]+$ ]]; }
valid_channel() { [[ "$1" =~ ^[A-Za-z0-9:_.-]+$ ]]; }
valid_bool()    { [[ "$1" =~ ^(true|false)$ ]]; }
# A PROVEN marketplace channel, as the shared resolver spells it. Separate from
# valid_channel on purpose: `@` is not something a person may pass with --channel.
valid_paired_channel() { [[ "$1" =~ ^plugin:[A-Za-z0-9_.-]+@[A-Za-z0-9_.-]+$ ]]; }
# HOAI_SERVICE_NAMESPACE, the side by side install (lib/watcher-service.mjs
# serviceNamespace holds the same rule). Anything else means unset.
valid_namespace() { [[ "$1" =~ ^[a-z0-9]{1,16}$ ]]; }
xml_escape()    { local s="$1"; s="${s//&/&amp;}"; s="${s//</&lt;}"; s="${s//>/&gt;}"; printf '%s' "$s"; }
require_id()    { [ -n "${ASSISTANT_ID:-}" ] || die "missing --assistant <id>"; valid_id "$ASSISTANT_ID" || die "--assistant must be a positive integer"; }

# Ensure the systemd --user bus is reachable (headless / SSH / cloud-init hosts
# often have no login session, so XDG_RUNTIME_DIR is unset and the user bus is
# down). Enables linger FIRST so the user manager can run without a session.
ensure_user_bus() {
  export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  loginctl enable-linger "$(id -un)" >/dev/null 2>&1 || warn "could not enable linger (service may stop on logout)"
  if ! systemctl --user show-environment >/dev/null 2>&1; then
    die "systemd --user is unreachable (no user bus / XDG_RUNTIME_DIR). Run this as the target user with a login session, or first: loginctl enable-linger $(id -un) && (re-login)"
  fi
}

# The systemd --user manager reads units from ITS HOME's ~/.config/systemd/user
# (the account's), never from another HOME this script runs with: a unit written
# there is never found by name, and every install of it would fail with a
# generic error. Refused by name, before anything is written (round 2).
phys_dir() { (cd "$1" 2>/dev/null && pwd -P) || printf '%s' "$1"; }
require_manager_home() {
  local mh
  mh="$(systemctl --user show-environment 2>/dev/null | sed -n 's/^HOME=//p' | head -n 1)"
  [ -n "$mh" ] || return 0
  [ "$(phys_dir "$mh")" = "$(phys_dir "$HOME")" ] && return 0
  die "refused: this account's systemd --user manager reads its units from $mh/.config/systemd/user, not from this HOME ($HOME); no service file or run.sh was written"
}

# A rolled back rename puts the previous run.sh back (round 2 L5): before the
# old job or unit is started again, so it never starts on the new one.
RUN_SH_PREV=""
restore_run_sh() {
  if [ -n "$RUN_SH_PREV" ] && [ -f "$RUN_SH_PREV" ]; then mv -f "$RUN_SH_PREV" "${RUN_SH_PREV%.prev}" || true; fi
  RUN_SH_PREV=""
}
rollback_die() {
  restore_run_sh
  die "$@"
}

# Round 2 L6: end the old socket's server when one of its panes runs in this
# agent's folder (said as a service note); one elsewhere is another agent's.
end_orphan_old_tmux() { # $1 id $2 workdir
  command -v tmux >/dev/null 2>&1 || return 0
  local sock panes wd_phys
  sock="$(legacy_tmux_name_for "$1")"
  panes="$(tmux -L "$sock" list-panes -a -F '#{pane_current_path}' 2>/dev/null)" || return 0
  wd_phys="$(phys_dir "$2")"
  if printf '%s\n' "$panes" | grep -qxF -e "$2" -e "$wd_phys"; then
    tmux -L "$sock" kill-server >/dev/null 2>&1 || true
    service_note "ended an old tmux server (socket $sock, left by an older version) with a pane in this agent's folder $2: it would have held the new job's start for good"
  fi
}

# =============================================================================
# install
# =============================================================================
cmd_install() {
  require_id
  # Before anything is written (see acquire_install_lock).
  if ! acquire_install_lock "$ASSISTANT_ID"; then
    info "install already in progress for agent $ASSISTANT_ID (another hoai-agent install holds $(install_lock_for "$ASSISTANT_ID")); nothing was changed"
    return 0
  fi
  local backend="${BACKEND:-$DEFAULT_BACKEND}"
  local channel="${CHANNEL:-$DEFAULT_CHANNEL}"
  local auto="${AUTO_APPROVE:-true}"
  local workdir="${WORKDIR:-$(default_workdir_for "$ASSISTANT_ID")}"
  local paired_node_bin=""
  local statedir; statedir="$(statedir_for "$ASSISTANT_ID")"
  valid_channel "$channel" || die "--channel must match [A-Za-z0-9:_.-] (got '$channel')"
  valid_bool "$auto"       || die "--auto-approve must be 'true' or 'false'"

  info "Preflight"
  command -v git    >/dev/null 2>&1 || die "git not found, install it first"
  command -v bun    >/dev/null 2>&1 || die "bun not found, install from https://bun.sh"
  command -v claude >/dev/null 2>&1 || die "claude not found, install Claude Code (claude.ai/code)"
  # hoai answers Claude Code's startup screens under expect, and an unattended
  # launch without it would stop on the first one.
  command -v expect >/dev/null 2>&1 || die "expect not found, macOS ships it; on Linux: apt install expect"
  if [ "${ALWAYS_ON:-}" = "1" ]; then
    # The supervisor runs hoai (bin/hoai-core.mjs), which is Node.js. Checked
    # here, before anything is written, so a refused install leaves nothing.
    command -v node >/dev/null 2>&1 \
      || die "supervisor:node-not-found the always-on supervisor runs hoai on Node.js and no node is on PATH. Install Node.js 18 or newer, then run this again."
    # WHICH claude gets baked. `command -v claude` under the watcher's service PATH
    # returned a stale /usr/local/bin/claude 2.1.22 that does not know the launch flag
    # and exited rc=1 on every launch (board row 84296679, kc-server, 2026-10-12: five
    # agents, about 420 silent crash loops). The selector asks each candidate (the
    # native ~/.local/bin/claude first, then every claude on PATH) whether it knows
    # --dangerously-load-development-channels and names the ones it steps over.
    # Decided HERE, before anything is written, so a refusal leaves nothing behind.
    select_claude
    # Optional: without tmux the agent still runs, but /compact from the app
    # cannot reach it (finding 8), so say so now rather than let it be found.
    command -v tmux >/dev/null 2>&1 \
      || warn "tmux not found: the agent will run without it and remote compact will be OFF. Install tmux (brew install tmux, or apt install tmux), then: hoai-agent restart --assistant $ASSISTANT_ID"
  fi
  if [ -n "${ANTHROPIC_API_KEY:-}" ]; then
    warn "ANTHROPIC_API_KEY is set in your shell. The plugin needs a Claude *subscription*"
    warn "login (Pro/Max/Team), not API-key auth, or inbound messages are silently dropped."
    warn "The service runs with a clean env so it won't inherit this, but 'claude /status'"
    warn "must show 'Claude subscription'."
  fi
  ok "git, bun, claude, expect present"

  # --- ensure plugin clone + deps ------------------------------------------
  if [ ! -f "$PLUGIN_DIR/server.ts" ]; then
    [ "${NO_CLONE:-}" = "1" ] && die "plugin not found at $PLUGIN_DIR and --no-clone was given"
    info "Cloning plugin → $PLUGIN_DIR"
    git clone --depth 1 "$PLUGIN_REPO" "$PLUGIN_DIR"
  fi
  PLUGIN_DIR="$(cd -P "$PLUGIN_DIR" >/dev/null 2>&1 && pwd)"
  info "Installing plugin deps (bun install)"
  ( cd "$PLUGIN_DIR" && bun install --no-summary >/dev/null 2>&1 ) || warn "bun install reported an issue (continuing)"
  install_daemon_wrapper
  ok "plugin ready at $PLUGIN_DIR"

  # --- workspace + .mcp.json ------------------------------------------------
  mkdir -p "$workdir" "$statedir"
  local mcp="$workdir/.mcp.json"
  if [ -n "${API_KEY:-}" ] && [ -n "${USER_ID:-}" ]; then
    [ -f "$mcp" ] && cp "$mcp" "$mcp.bak" && warn "backed up existing .mcp.json → $mcp.bak"
    write_mcp_json "$mcp" "$backend" "$API_KEY" "$USER_ID" "$ASSISTANT_ID" "$auto" "${OPENAI_VOICE_KEY:-}"
    bun -e 'JSON.parse(require("fs").readFileSync(process.argv[1],"utf8"))' "$mcp" >/dev/null 2>&1 \
      || die "generated .mcp.json is not valid JSON, check your --key/--user/--backend for special characters"
    ok "wrote $mcp"
  elif [ ! -f "$mcp" ]; then
    # No .mcp.json and no key. That is only launchable as a PROVEN paired
    # marketplace folder (see "THE SECOND WORLD" at the top of this file).
    local proven
    if ! proven="$(prove_paired_topology "$workdir" "$ASSISTANT_ID")"; then
      die "no .mcp.json in $workdir and no creds given, and it is not a proven paired folder either: $proven. (A clone-style agent instead needs --key <api-key> --user <user-id>, or --dir <existing-project>.)"
    fi
    valid_paired_channel "$proven" || die "paired-topology:unusable-channel the resolver proved '$proven', which is not a marketplace channel spec"
    if [ -n "${CHANNEL:-}" ] && [ "$CHANNEL" != "$proven" ]; then
      die "paired-topology:channel-mismatch --channel $CHANNEL was given, but $workdir is a paired marketplace folder whose proven channel is $proven; launching on the other one comes up Connected and hears nothing. Drop --channel."
    fi
    channel="$proven"
    # The marketplace plugin starts its MCP server and every hook with a bare `node`
    # (.claude-plugin/plugin.json), and the service PATH below was built for the clone
    # topology, which runs `bun`. With no node on that PATH the session comes up and the
    # channel never does: deaf again. So node is resolved NOW, before anything is
    # written, and its directory goes on the service PATH.
    paired_node_bin="$(command -v node || true)"
    [ -n "$paired_node_bin" ] || die "paired-topology:node-not-found the HOAI marketplace plugin runs on Node.js and no node is on PATH, so the background agent would start and never hear anything. Install Node.js 18 or newer, then run this again."
    ok "paired folder proven for agent $ASSISTANT_ID (folder pin, agent credentials, plugin install record): channel $channel"
  else
    info "using existing $mcp (pass --key/--user to regenerate)"
  fi
  if [ ! -f "$workdir/CLAUDE.md" ]; then
    write_claude_md_stub "$workdir/CLAUDE.md"
    ok "wrote $workdir/CLAUDE.md (stub, see plugin README Step 5 for full peer rules)"
  fi
  # A MARKETPLACE channel (plugin:<plugin>@<marketplace>) already ships the
  # activity rail in the plugin's own hooks/hooks.json, so writing the settings
  # entries beside it would run the forwarder TWICE per event: two node spawns
  # per tool call, paid on every tool call, for nothing. Same skip the two
  # bootstraps make. A server:<name> channel is a clone and needs the entries,
  # because Claude Code reads a hooks file only for an INSTALLED plugin.
  #
  # Run from a marketplace plugin's VERSIONED cache dir (where the watcher's
  # sweep runs this script), the entries are left as they are. They would be
  # absolute paths into a dir the next plugin update replaces and prunes, and
  # nothing writes them again (a launch from that cache detects as marketplace
  # and registers no hooks), so every hook would point at a missing file. A clone
  # folder keeps the entries that point at its durable checkout; a marketplace
  # folder that merely carries another .mcp.json gets its rail from the plugin's
  # hooks.json, where entries here would run the forwarder twice per event.
  local plugin_cache; plugin_cache="$(plugin_cache_key "$PLUGIN_DIR")"
  case "$channel" in
    plugin:*)
      info "marketplace channel ($channel): its own hooks file already carries the activity rail"
      ;;
    *)
      if [ -n "$plugin_cache" ]; then
        info "this installer runs from a versioned plugin cache dir ($PLUGIN_DIR) that the next plugin update removes, so the activity hook entries in $workdir/.claude/settings.local.json are left as they are"
      else
        install_hook_entries "$workdir" "$PLUGIN_DIR"
      fi
      install_denied_tools "$workdir" "$PLUGIN_DIR"
      ;;
  esac

  if [ "${ALWAYS_ON:-}" != "1" ]; then
    say_launch_hint "$workdir" "$channel"
    return 0
  fi

  # --- always-on supervisor -------------------------------------------------
  info "Installing always-on supervisor (auto-restart + survive reboot)"
  case "$OS" in
    Darwin|Linux) ;;
    *) die "unsupported OS '$OS' (macOS + Linux only; on Windows use WSL)" ;;
  esac
  # Read back BEFORE anything of the supervisor is written (board row d6198bb6):
  # this HOME's own name recording another HOME, or none readable, is refused
  # and left exactly as it is; the OLD name (before 0.69.4) is renamed in
  # place below when it is this HOME's, and left alone and said otherwise.
  need_home_id
  if [ "$OS" = Linux ]; then ensure_user_bus; require_manager_home; fi
  probe_service "$ASSISTANT_ID" own
  case "$PROBE_STATE" in
    foreign|unknown) die "$PROBE_SAY" ;;
  esac
  probe_service "$ASSISTANT_ID" legacy
  local legacy_state="$PROBE_STATE"
  case "$legacy_state" in
    foreign) service_note "$PROBE_SAY" ;;
    unknown)
      # The loaded old job or unit may be this HOME's own: with this HOME's old
      # service file there, a new one beside it could run this agent twice.
      if file_records_home "$(legacy_service_file_for "$ASSISTANT_ID")"; then
        die "refused: the old service of agent $ASSISTANT_ID could not be read back (${PROBE_SAY#left the }) and this HOME's old service file $(legacy_service_file_for "$ASSISTANT_ID") is there, so a new one beside it could run the agent twice; nothing was changed"
      fi
      service_note "$PROBE_SAY" ;;
  esac
  local claude_bin bun_bin expect_bin node_bin tmux_bin path topology plugin_key=""
  claude_bin="${SELECTED_CLAUDE_BIN:-$(command -v claude)}"
  bun_bin="$(command -v bun)"
  expect_bin="$(command -v expect)"
  # Resolved and BAKED now: run.sh starts hoai with exactly this node, and the
  # marketplace plugin's MCP server and hooks find `node` on the service PATH.
  node_bin="$(command -v node)"
  tmux_bin="$(command -v tmux || true)"
  # The chosen claude's directory leads: a stale claude further along the same PATH
  # (a /usr/local/bin one behind node's directory) can then never be the one a launch
  # finds by name. Each directory is listed once.
  path="$(dirname "$claude_bin"):$(dirname "$node_bin"):$(dirname "$bun_bin"):$(dirname "$expect_bin")"
  [ -n "$tmux_bin" ] && path="$path:$(dirname "$tmux_bin")"
  # Homebrew's prefix is a macOS directory; on a Linux unit it only names a path that cannot exist.
  if [ "$OS" = "Darwin" ]; then
    path="$path:$HOME/.local/bin:/opt/homebrew/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
  else
    path="$path:$HOME/.local/bin:/usr/local/bin:/usr/bin:/bin:/usr/sbin:/sbin"
  fi
  path="$(dedupe_path "$path")"
  # Stamped for EVERY always-on install (fact 3). The app records alwaysOn in BGOS only
  # after it has seen this agent connect, and until then the agent's own daemon reads
  # "off" with a supervisor installed, which used to mean "remove it", within seconds,
  # from inside the very session the supervisor runs. lib/always-on-grace.ts.
  date +%s > "$statedir/installed-at"
  printf '%s\n' "$SUPERVISOR_GENERATION" > "$statedir/supervisor-generation"
  # Which plugin root run.sh resolves at every launch. A marketplace channel names its
  # own install record (plugin:<plugin>@<marketplace>); anything else is a clone, whose
  # checkout is the one this script runs from.
  case "$channel" in
    plugin:*) topology="marketplace"; plugin_key="${channel#plugin:}" ;;
    *)        topology="clone" ;;
  esac
  # A clone-style folder installed by a bgos-agent that runs FROM a marketplace plugin's
  # versioned cache dir (<config>/plugins/cache/<marketplace>/<plugin>/<version>, where
  # the watcher's sweep runs it from): that dir is replaced by the next plugin update and
  # pruned after it, so it is no checkout to bake. Its root is looked up in the install
  # record at every launch instead, exactly like a marketplace agent's. Only the ROOT
  # changes: hoai still reads the channel from this folder's own .mcp.json.
  if [ "$topology" = "clone" ] && [ -n "$plugin_cache" ]; then
    topology="marketplace"
    plugin_key="$plugin_cache"
    info "this installer runs from a versioned plugin cache dir ($PLUGIN_DIR), so the supervisor looks the plugin root up in the install record ($plugin_key) at every launch"
  fi
  # A clone supervisor starts hoai from THIS checkout at every launch. Run from an npx
  # cache, that is a directory npm may delete; then the agent stops with a named
  # plugin-root-missing. Generation 1 copied what it needed into run.expect and never
  # noticed; hoai has to come from somewhere real, so say so now.
  if [ "$topology" = "clone" ]; then
    case "$PLUGIN_DIR" in
      */_npx/*) warn "this supervisor starts hoai from $PLUGIN_DIR, a package-runner cache that npm may delete; if it does, the agent stops with plugin-root-missing (hoai-agent status shows it). A git clone or the marketplace plugin is a durable home." ;;
    esac
  fi
  # Generation 1 launched through run.expect. It is not the launch path any more (hoai
  # embeds the shared gate block itself), so a reinstall over generation 1 removes it.
  rm -f "$statedir/run.expect"
  # Round 2 L5: written beside and moved into place, never rewritten in place (a
  # running bash reads its script as it goes), and the previous one kept until
  # the service is installed: a rolled back rename puts it back for the old job.
  RUN_SH_PREV=""
  if [ -f "$statedir/run.sh" ] && cp -p "$statedir/run.sh" "$statedir/run.sh.prev"; then RUN_SH_PREV="$statedir/run.sh.prev"; fi
  write_run_sh "$statedir/run.sh.tmp" "$statedir" "$ASSISTANT_ID" "$node_bin" "$topology" "$plugin_key" "$PLUGIN_DIR" "$(tmux_name_for "$ASSISTANT_ID")"
  chmod +x "$statedir/run.sh.tmp"
  mv -f "$statedir/run.sh.tmp" "$statedir/run.sh"

  # The service environment carries what the shell that installed it had and the service
  # would otherwise lose: a custom CLAUDE_CONFIG_DIR (silently dropped before, so the
  # service started the wrong install or a signed-out claude), and the side by side
  # namespace, so the agent's daemon and the watcher it installs stay in it (design
  # section 4).
  local config_dir="${CLAUDE_CONFIG_DIR:-}" namespace=""
  if [ -n "${HOAI_SERVICE_NAMESPACE:-}" ]; then
    if valid_namespace "$HOAI_SERVICE_NAMESPACE"; then
      namespace="$HOAI_SERVICE_NAMESPACE"
    else
      warn "HOAI_SERVICE_NAMESPACE must be 1 to 16 lowercase letters or digits; it is ignored, so this agent's service is not namespaced"
    fi
  fi
  case "$OS" in
    Darwin) install_launchd "$ASSISTANT_ID" "$workdir" "$statedir" "$path" "$config_dir" "$namespace" "$legacy_state" ;;
    Linux)  install_systemd "$ASSISTANT_ID" "$workdir" "$statedir" "$path" "$config_dir" "$namespace" "$legacy_state" ;;
    *)      die "unsupported OS '$OS' (macOS + Linux only; on Windows use WSL)" ;;
  esac
  [ -n "$RUN_SH_PREV" ] && rm -f "$RUN_SH_PREV"
  RUN_SH_PREV=""
  # Round 2 L6: a tmux server from before 0.69.4 orphaned on the OLD socket (its job gone,
  # killed past run.sh's trap) with a pane in this agent's folder would hold the
  # new job's singleton wait for good; the new run.sh clears only its own
  # socket. Ended once the new service is in place (an install typed into that
  # orphan's session ends with it), unless the old name is another HOME's or
  # unreadable.
  if [ "$legacy_state" = absent ]; then end_orphan_old_tmux "$ASSISTANT_ID" "$workdir"; fi

  cmd_link >/dev/null 2>&1 || true
  echo
  ok "Agent $ASSISTANT_ID is always-on."
  printf '  workspace : %s\n' "$workdir"
  printf '  logs      : hoai-agent logs --assistant %s   (%s/agent.log)\n' "$ASSISTANT_ID" "$statedir"
  printf '  status    : hoai-agent status --assistant %s\n' "$ASSISTANT_ID"
  printf '  watch     : hoai-agent attach --assistant %s   (its tmux session, when tmux is installed)\n' "$ASSISTANT_ID"
  printf '  off       : hoai-agent uninstall --assistant %s\n' "$ASSISTANT_ID"
}

# The claude an always-on install bakes, chosen by what it can DO (lib/claude-binary.mjs),
# never by PATH order alone. Sets SELECTED_CLAUDE_BIN. A selector that cannot run at
# all falls back to the first claude on PATH with a warning: this check must never be
# the reason an install fails, only a stale claude may be.
select_claude() {
  local out line status="" bin="" version="" reason="" message=""
  out="$(node "$PLUGIN_DIR/bin/hoai-select-claude.mjs" 2>&1)" || true
  while IFS= read -r line; do
    case "$line" in
      HOAI_CLAUDE_OK$'\t'*)
        status="ok"; line="${line#HOAI_CLAUDE_OK$'\t'}"
        bin="${line%%$'\t'*}"; version="${line#*$'\t'}"
        ;;
      HOAI_CLAUDE_REFUSED$'\t'*)
        status="refused"; line="${line#HOAI_CLAUDE_REFUSED$'\t'}"
        reason="${line%%$'\t'*}"; message="${line#*$'\t'}"
        ;;
      skipping\ *) warn "${line}" ;;
    esac
  done <<<"$out"
  case "$status" in
    ok)
      SELECTED_CLAUDE_BIN="$bin"
      info "claude: $bin${version:+ ($version)}"
      ;;
    refused)
      die "claude:$reason $message"
      ;;
    *)
      SELECTED_CLAUDE_BIN="$(command -v claude)"
      warn "could not check which claude to use; using $SELECTED_CLAUDE_BIN (the first on PATH)"
      ;;
  esac
}

# A PATH with each directory once, first occurrence kept. The baked service PATH is
# built from several lists that share directories, and a duplicated PATH hides which
# entry won when a stale tool is shadowed (board row 84296679, fix 5).
dedupe_path() { # $1 colon separated path
  local out="" seg IFS=:
  for seg in $1; do
    [ -n "$seg" ] || continue
    case ":$out:" in
      *":$seg:"*) ;;
      *) out="${out:+$out:}$seg" ;;
    esac
  done
  printf '%s' "$out"
}

# --- the paired topology (a workspace with no .mcp.json) ----------------------
# Prints the PROVEN channel spec and returns 0, or prints the named refusal and
# returns 1. Never guesses: anything that is not the prover's own OK line is a
# refusal, including the prover failing to run at all.
prove_paired_topology() { # $1 workdir $2 assistant id
  local out line
  out="$(bun "$PLUGIN_DIR/bin/bgos-doctor.mjs" --prove-paired-topology --workdir "$1" --assistant-id "$2" 2>&1)" || true
  line="$(printf '%s\n' "$out" | grep -E '^HOAI_TOPOLOGY_(OK|REFUSED) ' | tail -n 1 || true)"
  case "$line" in
    "HOAI_TOPOLOGY_OK "*)      printf '%s' "${line#HOAI_TOPOLOGY_OK }"; return 0 ;;
    "HOAI_TOPOLOGY_REFUSED "*) printf '%s' "${line#HOAI_TOPOLOGY_REFUSED }"; return 1 ;;
  esac
  printf 'paired-topology:prover-failed the topology check itself did not run: %s' "$(printf '%s\n' "$out" | grep -v '^[[:space:]]*$' | grep -vE '^(Bun v|Node\.js v)' | tail -n 4 | tr '\n' ' ' || true)"
  return 1
}

# The install record key (<plugin>@<marketplace>) for a plugin dir that IS a versioned
# marketplace cache dir, <config>/plugins/cache/<marketplace>/<plugin>/<version>, read
# off the path the way bin/bgos-install-method.mjs marketplaceNameFromPluginPath reads
# it; nothing for any other dir. $1 is physical (cd -P), so the config dir is resolved
# the same way before the two are compared (/var and /private/var on macOS).
plugin_cache_key() { # $1 physical plugin dir
  local cache rel mkt rest plugin
  cache="$(cd -P "${CLAUDE_CONFIG_DIR:-$HOME/.claude}/plugins/cache" >/dev/null 2>&1 && pwd)" || return 0
  case "$1/" in
    "$cache"/*/*/*/) ;;
    *) return 0 ;;
  esac
  rel="${1#"$cache"/}"
  mkt="${rel%%/*}"
  rest="${rel#*/}"
  plugin="${rest%%/*}"
  [[ "$mkt" =~ ^[A-Za-z0-9_.-]+$ ]] && [[ "$plugin" =~ ^[A-Za-z0-9_.-]+$ ]] || return 0
  printf '%s@%s' "$plugin" "$mkt"
}

# --- file generators ---------------------------------------------------------
install_daemon_wrapper() {
  local source="$PLUGIN_DIR/bin/bgos-daemon-wrapper.mjs"
  [ -f "$source" ] || die "daemon wrapper not found at $source"
  bun "$source" --install "$WRAPPER_PATH" >/dev/null \
    || die "could not install the stable daemon wrapper at $WRAPPER_PATH"
}

# JSON via bun + JSON.stringify: values are passed as env vars (no shell/JSON
# interpolation), so a key/url with quotes or backslashes can't corrupt or
# inject into the config.
write_mcp_json() { # $1 path $2 backend $3 key $4 user $5 id $6 auto [$7 openai-key]
  BGOS_WRAPPER="$WRAPPER_PATH" BGOS_PLUGIN="$PLUGIN_DIR" BGOS_MCP_NAME="$MCP_SERVER_NAME" BGOS_B="$2" BGOS_K="$3" BGOS_U="$4" BGOS_AID="$5" BGOS_AUTO="$6" BGOS_OAI="${7:-}" \
  bun -e '
    const e = process.env;
    const env = { BGOS_BACKEND_URL: e.BGOS_B, BGOS_API_KEY: e.BGOS_K, BGOS_USER_ID: e.BGOS_U,
                  BGOS_ASSISTANT_ID: e.BGOS_AID, BGOS_AUTO_APPROVE: e.BGOS_AUTO };
    // Optional: enables live voice calls (Talk button), see README "Voice Calls".
    if (e.BGOS_OAI) env.BGOS_OPENAI_API_KEY = e.BGOS_OAI;
    const cfg = { mcpServers: { [e.BGOS_MCP_NAME]: { command: "bun", args: [e.BGOS_WRAPPER, "--plugin-dir", e.BGOS_PLUGIN], env } } };
    process.stdout.write(JSON.stringify(cfg, null, 2) + "\n");
  ' > "$1"
}

write_claude_md_stub() { # $1 path
  cat > "$1" <<'MD'
## BGOS plugin

You are connected to the BGOS chat app via the `bgos` MCP plugin. Messages from
the user (and other agents) arrive as `<channel source="bgos">` events.

- Always answer the user through the `reply` tool, plain terminal output never
  reaches their chat.
- For peer-agent messages (meta carries `peer_conversation_id` / `turn_state`),
  use `send_to_peer`, not `reply`.

## Missions (trained flow, capability #20)

BGOS pins a live goal card in the chat when you create a mission. When a user
request is MULTI-STEP (roughly 3 or more distinct steps, or work spanning
tools and minutes), FIRST call the `create_mission` tool with 4 to 10 BINARY
mini-goals, each with a `done_when` line stating the observable check that
proves it ("the URL returns 200", never "it looks good"). Then reply and work
normally; do not narrate the mission in prose. The MOMENT a mini-goal's check
is true, call `tick_mini_goal` with its `goal_id` and a short `evidence` line;
tick per goal as you go, never in one batch at the end (ticks are quiet, no
user ping). Ticking the last open goal completes the mission automatically;
call `complete_mission` only to end early when remaining goals became moot.
ONE active mission per agent; creating a new one abandons the previous. Do NOT
create missions for single-step or conversational asks. This applies even when
the bgos tools are deferred: search for the tool by name and call it.

See the plugin README "Step 5" for the full peer-tool guidance and paste it here
if this agent talks to other agents.
MD
}

# run.sh: the service entry point, supervisor generation 2 (design section 4).
#
#   launchd / systemd --user
#     -> run.sh             stale server kill, singleton wait, fast fail accounting, trap
#        -> tmux -L hoai-<id> new-session -d -s hoai-<id> -c <workdir>   (when tmux exists)
#           -> node <CURRENT plugin root>/bin/hoai-core.mjs               (HOAI_SUPERVISED=1)
#              -> expect + gate block -> claude --resume <pinned id> | --session-id <pinned id>
#
# The OS service relaunches run.sh whenever it exits; that is the always-on
# restart. run.sh adds what the service cannot: never two sessions in one
# folder, visible back-off when the agent will not stay up, and a STOP that
# stops the agent instead of orphaning it in tmux.
#
# What moved OUT of here, and why (findings 7 and 8). Generation 1 spawned
# claude from a run.expect with no session id, so every restart was a FRESH
# conversation (Ava added --resume by hand on kc-server), and with no tmux the
# daemon logged "remote compact capability OFF". hoai already did the session
# part right (pin, resume, create by id, fresh fallback committed only after the
# health window), so the supervisor runs hoai instead of re-implementing that in
# Tcl, and runs it inside tmux so lib/compact-inject.ts can type /compact into
# the session. The gate rules are hoai's too: it embeds lib/gate-block.tcl from
# the plugin root it is started from, so no copy is frozen into this file.
#
# The plugin root is resolved at EVERY launch, never baked: a marketplace agent
# reads its install record (installed_plugins.json, honouring CLAUDE_CONFIG_DIR)
# and a clone agent its checkout. A restart therefore always lands on the
# installed version, which is what makes "restart onto a staged update" a plain
# restart (design section 5). A root that cannot be found is a named failure in
# launch-status (plugin-root-missing) and a nonzero exit, never a guess.
#
# Everything baked at install is written as a %q-quoted assignment and the body
# is a QUOTED heredoc, so no path (spaces, quotes, $) is ever re-parsed as code.
write_run_sh() { # $1 outpath $2 statedir $3 assistant id $4 node_bin $5 topology $6 plugin_key $7 clone_root $8 tmux socket
  {
    printf '#!/usr/bin/env bash\n'
    printf '# Auto-generated by bgos-agent: the always-on supervisor, generation %s.\n' "$SUPERVISOR_GENERATION"
    printf 'sd=%q\n' "$2"
    printf 'id=%q\n' "$3"
    printf 'node_bin=%q\n' "$4"
    printf 'topology=%q\n' "$5"
    printf 'plugin_key=%q\n' "$6"
    printf 'clone_root=%q\n' "$7"
    # The agent's own tmux socket, named after this HOME (tmux_name_for): one
    # socket directory per account, so a run.sh of another HOME's agent with the
    # same id never ends this one's server, nor this one that one's.
    printf 'sock=%q\n' "${8:-hoai-$3}"
    cat <<'SH'
exec >> "$sd/agent.log" 2>&1
ts() { date '+%Y-%m-%d %H:%M:%S'; }
note_status() { echo "$(ts) $*" > "$sd/launch-status"; }
workdir="$(pwd -P)"
have_tmux=0
command -v tmux >/dev/null 2>&1 && have_tmux=1
child=""

# Stopping the service stops the agent. launchctl kickstart -k, bootout,
# systemctl --user restart and uninstall all send TERM here; the tmux server
# daemonizes out of launchd's process group, so without this it (and claude in
# it) would outlive the job and the next run.sh would find it in the folder.
# Every wait below is `sleep & wait`, so the trap runs at once, not after a nap.
#
# Without tmux, hoai runs as a job of its OWN process group (set -m below), so
# the stop reaches the whole group: node, the expect it spawned and the claude
# under expect. TERM to node alone ended node and left expect and claude
# running in the folder. -- -<pgid> names the group; the plain pid is the
# fallback for a group that is already gone.
on_stop() {
  echo "[$(ts)] stop requested: ending agent $id"
  if [ "$have_tmux" = 1 ]; then tmux -L "$sock" kill-server >/dev/null 2>&1; fi
  if [ -n "$child" ]; then
    kill -TERM -- "-$child" >/dev/null 2>&1 || kill -TERM "$child" >/dev/null 2>&1
  fi
  exit 0
}
trap on_stop TERM INT HUP

# A server still on this agent's OWN socket was left by a run.sh that could not
# trap (SIGKILL). This run.sh supersedes it, so it goes first: left alone, its
# claude would sit in the folder and the singleton wait below would wait on our
# own orphan forever. Only this agent's socket is touched, never another server.
if [ "$have_tmux" = 1 ] && tmux -L "$sock" list-sessions >/dev/null 2>&1; then
  echo "[$(ts)] a tmux server from an earlier run is still on socket $sock; ending it before taking over"
  tmux -L "$sock" kill-server >/dev/null 2>&1
fi

# Singleton handoff: wait for any incumbent 'claude' already running in THIS
# workspace (a manual session started before Always-on was flipped, or the
# session that just installed this supervisor) to exit, so we never
# double-connect as the same assistant. Sessions in other dirs are ignored.
others_in_workdir() {
  local pid cwd
  # Match the basename so both a bare-name launch (comm=claude) and an absolute-
  # path launch (comm=/path/claude) are caught. NOTE: a node-hosted claude
  # (comm=node) isn't detected, native + path installs are.
  for pid in $(ps -axww -o pid=,comm= | awk '{n=$2; sub(/.*\//,"",n); if(n=="claude") print $1}'); do
    if [ "$(uname -s)" = "Darwin" ]; then
      cwd="$(lsof -a -d cwd -p "$pid" -Fn 2>/dev/null | sed -n 's/^n//p' | head -1)"
    else
      cwd="$(readlink "/proc/$pid/cwd" 2>/dev/null)"
    fi
    [ "$cwd" = "$workdir" ] && printf '%s ' "$pid"
  done
}
while [ -n "$(others_in_workdir)" ]; do
  echo "[$(ts)] waiting for an incumbent claude in $workdir to exit before taking over"
  note_status "outcome=waiting-for-incumbent pids=$(others_in_workdir)"
  sleep 5 & wait $!
done

fails=$(cat "$sd/failcount" 2>/dev/null || echo 0)
case "$fails" in ''|*[!0-9]*) fails=0 ;; esac
start=$(date +%s)
echo "[$(ts)] starting agent (consecutive fast-fails: $fails)"
# Which claude this launch will find by name, and what it is. A stale one used to
# exit rc=1 at once and leave no trace of which binary it was (board row 84296679).
claude_at="$(command -v claude 2>/dev/null || true)"
if [ -n "$claude_at" ]; then
  echo "[$(ts)] claude: $claude_at $("$claude_at" --version </dev/null 2>&1 | head -n 1)"
else
  echo "[$(ts)] claude: not found on the service PATH ($PATH)"
fi
# Cleared first, so a launch that dies before hoai can write its line is never
# reported with the reason the PREVIOUS launch left behind.
note_status "outcome=starting"

# The node this launch runs on. Baked at install, but a node upgrade (a new
# Homebrew keg, an nvm or asdf switch) can remove that exact file, and then
# every launch failed, and was reported as a missing plugin root because the
# root lookup below runs on it. The service PATH leads with the directory node
# was found in at install and carries the usual ones after it, so the node it
# has now is that install's successor. None at all is its own named outcome.
node_missing=0
if [ ! -f "$node_bin" ] || [ ! -x "$node_bin" ]; then
  found_node="$(command -v node 2>/dev/null || true)"
  if [ -n "$found_node" ]; then
    echo "[$(ts)] the node baked at install ($node_bin) is gone; using $found_node from the service PATH"
    node_bin="$found_node"
  else
    node_missing=1
  fi
fi

# The installPath a Claude Code install record gives the HOAI plugin, read from
# this config dir's installed_plugins.json: the record named $1
# (<plugin>@<marketplace>), or with no name THE one HOAI plugin installed
# (hoai@<any marketplace>; the name is HOAI_PLUGIN_NAME in
# bin/bgos-install-method.mjs), never one of several. Prints nothing and fails
# when there is no such record.
installed_root() { # $1 record key, or '' for the sole HOAI plugin
  local cfg="${CLAUDE_CONFIG_DIR:-$HOME/.claude}"
  "$node_bin" -e '
    const fs = require("fs");
    const [file, key] = process.argv.slice(1);
    let doc = null;
    try { doc = JSON.parse(fs.readFileSync(file, "utf8")); } catch { process.exit(1); }
    const plugins = doc && doc.plugins && typeof doc.plugins === "object" ? doc.plugins : {};
    let name = key;
    if (!name) {
      const hoai = Object.keys(plugins).filter((k) => k.lastIndexOf("@") > 0 && k.slice(0, k.lastIndexOf("@")) === "hoai");
      if (hoai.length !== 1) process.exit(1);
      name = hoai[0];
    }
    const raw = plugins[name];
    const all = Array.isArray(raw) ? raw : raw && typeof raw === "object" ? [raw] : [];
    const records = all.filter((r) => r && typeof r === "object");
    const entry = records.find((r) => r.scope === "user") || records[0];
    const found = entry && typeof entry.installPath === "string" ? entry.installPath.trim() : "";
    if (!found) process.exit(1);
    process.stdout.write(found);
  ' "$cfg/plugins/installed_plugins.json" "$1" 2>/dev/null
}

# The CURRENT plugin root, resolved now, at every launch.
root=""
if [ "$node_missing" = 0 ]; then
  case "$topology" in
    marketplace)
      root="$(installed_root "$plugin_key")" || root=""
      ;;
    clone)
      root="$clone_root"
      # The checkout recorded at install can be pruned (an npx cache npm cleaned,
      # a versioned plugin cache dir an update replaced). Before that is a
      # failure, the installed plugin's own record is asked: hoai is the same
      # launcher from either root, and the channel still comes from the folder.
      if [ ! -f "$root/bin/hoai-core.mjs" ]; then
        found_root="$(installed_root "")" || found_root=""
        if [ -n "$found_root" ] && [ -f "$found_root/bin/hoai-core.mjs" ]; then
          echo "[$(ts)] the checkout recorded at install ($clone_root) has no bin/hoai-core.mjs any more; starting hoai from the installed plugin at $found_root"
          root="$found_root"
        fi
      fi
      ;;
  esac
fi

rc=0
how="hoai exit $rc"
if [ "$node_missing" = 1 ]; then
  rc=2
  how="node missing"
  note_status "outcome=node-missing baked=\"$node_bin\""
  echo "[$(ts)] cannot launch agent $id: no node at $node_bin (baked at install) and none on the service PATH. Install Node.js 18 or newer, then: hoai-agent install --assistant $id --always-on"
elif [ -z "$root" ] || [ ! -f "$root/bin/hoai-core.mjs" ]; then
  rc=2
  how="plugin root missing"
  note_status "outcome=plugin-root-missing topology=$topology key=${plugin_key:-none} root=\"${root:-none}\""
  echo "[$(ts)] cannot launch agent $id: no bin/hoai-core.mjs at the $topology plugin root (${root:-not found}). Reinstall the plugin, or run hoai-agent install again."
elif [ "$have_tmux" = 1 ]; then
  # BGOS_TMUX_SESSION and BGOS_TMUX_SOCKET in the session's environment are what
  # turn remote compact ON in the daemon (lib/compact-inject.ts). Spelled as
  # `env` arguments rather than `new-session -e`, which older tmux (3.0 and 3.1,
  # still shipped by LTS distributions) does not have.
  #
  # -f /dev/null: this call starts the agent's OWN server, and a server reads
  # the owner's ~/.tmux.conf when it starts. remain-on-exit there kept a dead
  # hoai's pane, so the wait below never ended and nothing relaunched it;
  # destroy-unattached ended the detached session at once (a crash loop); a
  # continuum restore filled the agent's server with the owner's sessions. No
  # other call here starts a server, so only this one needs it.
  #
  # hoai's stderr goes to hoai.err, read back below: the pane (its stdout and
  # stdin, which attach and remote compact use) vanishes with hoai, and with it
  # the one line that says why a hoai died before it could write launch-status
  # (a node too old to parse it, a pruned import, a fatal error).
  : > "$sd/hoai.err"
  if tmux -f /dev/null -L "$sock" new-session -d -s "$sock" -x 200 -y 50 -c "$workdir" \
      /bin/sh -c 'err=$1; shift; exec "$@" 2>>"$err"' hoai-stderr "$sd/hoai.err" \
      /usr/bin/env HOAI_SUPERVISED=1 "HOAI_SUPERVISED_ASSISTANT_ID=$id" \
      "BGOS_TMUX_SESSION=$sock" "BGOS_TMUX_SOCKET=$sock" \
      "$node_bin" "$root/bin/hoai-core.mjs"; then
    # A fixed 200x50 window (the layout this Mac's own wrapper proved): an
    # attaching terminal of another size must not reflow the agent's screen.
    tmux -L "$sock" set-option -g window-size manual >/dev/null 2>&1
    tmux -L "$sock" resize-window -t "=$sock:" -x 200 -y 50 >/dev/null 2>&1
    echo "[$(ts)] agent $id is running in tmux session $sock (remote compact ON; watch it with: hoai-agent attach --assistant $id)"
    while tmux -L "$sock" has-session -t "=$sock" 2>/dev/null; do sleep 5 & wait $!; done
    how="ran in tmux, hoai's own outcome is in launch-status"
    if [ -s "$sd/hoai.err" ]; then
      echo "[$(ts)] hoai's error output (stderr) from this launch:"
      tail -n 40 "$sd/hoai.err" | sed 's/^/  | /'
    fi
    # Still the line written before the launch: hoai ended before it measured
    # anything. Named, with its last stderr line, so status and the WEDGED line
    # say why instead of "starting".
    case "$(cat "$sd/launch-status" 2>/dev/null)" in
      *" outcome=starting")
        last="$(awk 'NF { l = $0 } END { gsub(/"/, "", l); print substr(l, 1, 200) }' "$sd/hoai.err" 2>/dev/null)"
        note_status "outcome=hoai-exited-without-status detail=\"${last:-no error output}\""
        ;;
    esac
  else
    rc=$?
    how="tmux new-session exit $rc"
    note_status "outcome=tmux-failed rc=$rc"
  fi
else
  # No tmux on this host: hoai runs here instead (expect still gives claude its
  # terminal), and remote compact is OFF, which the status line says out loud.
  note_status "outcome=starting compact=off reason=no-tmux"
  echo "[$(ts)] tmux is not installed: running agent $id without it, so remote compact is OFF"
  # Its own process group (job control on for this one job), so on_stop can
  # end hoai together with the expect and claude it starts. Off again at once:
  # nothing else here wants job control. (A run.sh killed with SIGKILL cannot
  # end the group; launchd's process group cleanup no longer reaches it either,
  # so its claude is then the incumbent the next run.sh waits for, as with a
  # session started by hand.)
  set -m
  HOAI_SUPERVISED=1 HOAI_SUPERVISED_ASSISTANT_ID="$id" "$node_bin" "$root/bin/hoai-core.mjs" &
  child=$!
  set +m
  wait "$child" || rc=$?
  child=""
  how="hoai exit $rc"
fi

dur=$(( $(date +%s) - start ))
if [ "$dur" -lt 20 ]; then fails=$(( fails + 1 )); else fails=0; fi
echo "$fails" > "$sd/failcount"
if [ "$fails" -ge 3 ]; then
  echo "[$(ts)] WEDGED: agent exited after ${dur}s ($how), $fails times in a row."
  # The reason the launch MEASURED (hoai's gate outcome, a refusal, a missing
  # root), not a guess. The generation 1 text blamed auth or .mcp.json for what
  # was, as often, a declined startup gate.
  echo "[$(ts)]   Last launch: $(cat "$sd/launch-status" 2>/dev/null || echo 'no launch-status was written')"
  sleep 60 & wait $!
fi
exit "$rc"
SH
  } > "$1"
}

# --- macOS launchd -----------------------------------------------------------
# bootout is async; poll for the label to actually unload before bootstrapping,
# and retry bootstrap on transient EBUSY, so re-install / restart don't race.
launchd_reload() { # $1 plist $2 label  -> returns nonzero on hard failure
  local plist="$1" label="$2" domain n=0 tries=0
  domain="gui/$(id -u)"
  launchctl bootout "$domain" "$plist" >/dev/null 2>&1 || true
  while launchctl print "$domain/$label" >/dev/null 2>&1; do
    n=$((n + 1)); [ "$n" -ge 40 ] && break; sleep 0.25
  done
  until launchctl bootstrap "$domain" "$plist" 2>/dev/null; do
    tries=$((tries + 1)); [ "$tries" -ge 5 ] && return 1; sleep 0.5
  done
  return 0
}

# launchctl print, read as #237's reader reads it (lib/watcher-service.mjs
# readProbe): 0 listed, 1 not listed (rc 113, or any failure that says "Could
# not find service"), 2 unknown (any other failure: an XPC error, a launchd
# that does not answer). Unknown is never taken for gone.
launchd_listed() { # $1 domain/label
  local rc=0 out
  out="$(launchctl print "$1" 2>&1)" || rc=$?
  case "$rc" in
    0)   return 0 ;;
    113) return 1 ;;
  esac
  if printf '%s\n' "$out" | grep -qi 'could not find service'; then return 1; fi
  return 2
}

# Boot one job out and wait, bounded, until launchd answers that it no longer
# has it (a bootout can fail and still unload, or succeed and unload later).
# Sets LAUNCHD_ST: 1 gone (read back as not listed, or, while no read answers,
# a bootout launchd accepted), 0 still listed, 2 unknown (no read answers and
# the bootout was not accepted). Sets LAUNCHD_CHECKS to the reads made.
LAUNCHD_ST=0
LAUNCHD_CHECKS=0
launchd_bootout_wait() { # $1 domain/label
  local rc=0
  launchctl bootout "$1" >/dev/null 2>&1 || rc=$?
  LAUNCHD_CHECKS=0
  while :; do
    LAUNCHD_ST=0; launchd_listed "$1" || LAUNCHD_ST=$?
    LAUNCHD_CHECKS=$((LAUNCHD_CHECKS + 1))
    [ "$LAUNCHD_ST" = 1 ] && return 0
    [ "$LAUNCHD_CHECKS" -ge 40 ] && break; sleep 0.25
  done
  if [ "$LAUNCHD_ST" = 2 ] && [ "$rc" = 0 ]; then LAUNCHD_ST=1; fi
  return 0
}
# What the next login finds of the old job, said in a rollback's failure.
old_plist_note() { # $1 old plist
  if [ -f "$1" ]; then printf 'the old plist is back, so the next login starts the old job'; else printf 'no plist of the old job is left, so run hoai-agent install again'; fi
}

# The rename of this HOME's OLD job (before 0.69.4) to the HOME-scoped label
# (round 2 M1): the NEW job is bootstrapped and read back FIRST, and only then
# is the old one booted out. An installer typed into the old job's own session
# dies at that bootout (its tmux server is the session), and the agent is
# already supervised under its new name; two jobs are loaded together only
# until the old one is gone (or, when it will not go, until the new one is
# booted out again), and the new one never runs claude beside the old one
# (run.sh's singleton wait holds it until the old claude has left the folder).
# When the new job does not come up it is removed and the old one stays loaded,
# as it was; when the old one will not go, or cannot be read back, the new one
# is booted out again and the old one stays, watched for a bounded time and
# loaded again on its own run.sh if a slow bootout ends it meanwhile. The old
# plist is parked in the agent's state dir before anything is loaded, so
# wherever this installer is ended the next login finds exactly ONE plist of
# the agent; every rollback puts it back. The old job's tmux server is ended
# once the job is gone (it daemonizes out of launchd's process group, so only
# run.sh's trap would end it).
launchd_rename() { # $1 id $2 new plist $3 new label -> 0 renamed, 1 rolled back (old loaded), 2 both may be loaded, 3 neither loaded, 4 rolled back, old job unreadable
  local id="$1" plist="$2" label="$3" domain n=0 tries=0 old_label old_plist parked="" st=0 taken=0
  domain="gui/$(id -u)"
  old_label="$(legacy_label_for "$id")"
  old_plist="$(legacy_plist_for "$id")"
  RENAME_FAILURE=""
  if [ -f "$old_plist" ]; then
    parked="$(statedir_for "$id")/$old_label.plist.renaming"
    mv -f "$old_plist" "$parked" 2>/dev/null || parked=""
  fi
  launchctl bootout "$domain/$label" >/dev/null 2>&1 || true
  while launchd_listed "$domain/$label"; do
    n=$((n + 1)); [ "$n" -ge 40 ] && break; sleep 0.25
  done
  until launchctl bootstrap "$domain" "$plist" 2>/dev/null; do
    tries=$((tries + 1)); [ "$tries" -ge 5 ] && break; sleep 0.5
  done
  st=0; launchd_listed "$domain/$label" || st=$?
  if [ "$st" != 0 ]; then
    # The new job did not come up (or cannot be read back): the old one was never touched.
    if [ "$st" = 2 ]; then
      RENAME_FAILURE="the new job \"$label\" could not be read back after its bootstrap"
      launchd_bootout_wait "$domain/$label"
      if [ "$LAUNCHD_ST" != 1 ]; then
        # It may be loaded: beside the old one, which was never booted out. One plist, the old one's, loads at the next login.
        rm -f "$plist"
        if [ -n "$parked" ] && [ -f "$parked" ]; then mv -f "$parked" "$old_plist"; fi
        return 2
      fi
    else
      RENAME_FAILURE="launchctl bootstrap $domain $plist failed (the new job \"$label\" is not loaded)"
    fi
    rm -f "$plist"
    if [ -n "$parked" ] && [ -f "$parked" ]; then mv -f "$parked" "$old_plist"; fi
    return 1
  fi
  launchd_bootout_wait "$domain/$old_label"
  st="$LAUNCHD_ST"
  if [ "$st" != 1 ]; then
    if [ "$st" = 2 ]; then
      RENAME_FAILURE="the old job \"$old_label\" could not be read back after its bootout (launchctl print failed)"
    else
      RENAME_FAILURE="the old job \"$old_label\" was still loaded after $LAUNCHD_CHECKS checks"
    fi
    launchd_bootout_wait "$domain/$label"
    st="$LAUNCHD_ST"
    if [ -n "$parked" ] && [ -f "$parked" ]; then mv -f "$parked" "$old_plist"; fi
    if [ "$st" != 1 ]; then
      # The new job did not go, or cannot be read back: it may still be loaded, so
      # the old one is never loaded again beside it. It waits on the old claude.
      # One plist, the old one's, loads at the next login.
      rm -f "$plist"
      return 2
    fi
    rm -f "$plist"
    # The old job may have gone after all (a bootout that was only slow, or one
    # that worked while launchd could not be read): it is watched for a bounded
    # time, an unknown read not ending the watch, and unless launchd still lists
    # it then, its own plist is bootstrapped again on its own run.sh. launchd
    # refuses a second bootstrap of a label it already has, so this never loads two.
    n=0
    while :; do
      st=0; launchd_listed "$domain/$old_label" || st=$?
      [ "$st" = 1 ] && break
      n=$((n + 1)); [ "$n" -ge 40 ] && break; sleep 0.25
    done
    if [ "$st" != 0 ]; then
      restore_run_sh
      # Each read decides: listed is loaded; not listed or unknown gets a
      # bootstrap, up to 5; unknown right after launchd took the plist is loaded
      # (taken tells only of the latest bootstrap).
      tries=0
      taken=0
      while :; do
        st=0; launchd_listed "$domain/$old_label" || st=$?
        [ "$st" = 0 ] && break
        if [ "$st" = 2 ] && [ "$taken" = 1 ]; then break; fi
        [ "$tries" -ge 5 ] && break
        tries=$((tries + 1))
        taken=0
        if launchctl bootstrap "$domain" "$old_plist" 2>/dev/null; then taken=1; else sleep 0.5; fi
      done
      if [ "$st" = 2 ] && [ "$taken" = 1 ]; then
        # launchd took its plist again: loaded, though no read answers.
        RENAME_FAILURE="$RENAME_FAILURE; it could not be read back, but launchd took its plist again"
        return 1
      fi
      if [ "$st" = 1 ]; then
        RENAME_FAILURE="$RENAME_FAILURE; then it unloaded after all and could not be loaded again after $tries tries ($(old_plist_note "$old_plist"))"
        return 3
      fi
      if [ "$st" = 2 ]; then
        RENAME_FAILURE="$RENAME_FAILURE; a bootstrap of its plist was tried $tries times and it still could not be read back ($(old_plist_note "$old_plist"))"
        return 4
      fi
    fi
    return 1
  fi
  # Gone: its tmux server goes with it, and so does its plist wherever it is.
  tmux -L "$(legacy_tmux_name_for "$id")" kill-server >/dev/null 2>&1 || true
  if [ -n "$parked" ]; then rm -f "$parked"; fi
  rm -f "$old_plist" "$(statedir_for "$id")/$old_label.plist.renaming"
  return 0
}

install_launchd() { # $1 id $2 workdir $3 statedir $4 path [$5 claude config dir] [$6 service namespace] [$7 old name's state]
  local id="$1" workdir="$2" statedir="$3" path="$4" config_dir="${5:-}" namespace="${6:-}" legacy_state="${7:-absent}"
  local label; label="$(label_for "$id")"
  local plist; plist="$(plist_for "$id")"
  local x_wd x_sd x_path x_home x_user
  x_wd="$(xml_escape "$workdir")"; x_sd="$(xml_escape "$statedir")"
  x_path="$(xml_escape "$path")";  x_home="$(xml_escape "$HOME")"
  # USER/LOGNAME so a headless Claude can find its Keychain login (keyed by
  # username), without them it falls to a "Not logged in" wall and never serves.
  x_user="$(xml_escape "$(id -un)")"
  # Optional entries, present only when the installing shell had them (see cmd_install).
  local x_extra=""
  if [ -n "$config_dir" ]; then
    x_extra="$x_extra    <key>CLAUDE_CONFIG_DIR</key><string>$(xml_escape "$config_dir")</string>"$'\n'
  fi
  if [ -n "$namespace" ]; then
    x_extra="$x_extra    <key>HOAI_SERVICE_NAMESPACE</key><string>$namespace</string>"$'\n'
  fi
  mkdir -p "$HOME/Library/LaunchAgents"
  cat > "$plist" <<PLIST
<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key><string>$label</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/bash</string>
    <string>$x_sd/run.sh</string>
  </array>
  <key>WorkingDirectory</key><string>$x_wd</string>
  <key>RunAtLoad</key><true/>
  <key>KeepAlive</key><true/>
  <key>ThrottleInterval</key><integer>10</integer>
  <key>ProcessType</key><string>Interactive</string>
  <key>StandardOutPath</key><string>$x_sd/service.out.log</string>
  <key>StandardErrorPath</key><string>$x_sd/service.err.log</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>PATH</key><string>$x_path</string>
    <key>HOME</key><string>$x_home</string>
    <key>TERM</key><string>xterm-256color</string>
    <key>USER</key><string>$x_user</string>
    <key>LOGNAME</key><string>$x_user</string>
    <key>CLAUDE_CODE_ENABLE_TODO_TOOLS</key><string>1</string>
${x_extra}  </dict>
</dict>
</plist>
PLIST
  plutil -lint "$plist" >/dev/null || die "generated plist failed validation: $plist"
  if [ "$legacy_state" = own ]; then
    local renamed=0
    launchd_rename "$id" "$plist" "$label" || renamed=$?
    case "$renamed" in
      0) ok "launchd service $label loaded"
         service_note "renamed the launchd job \"$(legacy_label_for "$id")\" (installed from this HOME by an older version) to launchd job \"$label\"" ;;
      1) rollback_die "migration rolled back (the old job \"$(legacy_label_for "$id")\" stays loaded, the new one is removed): $RENAME_FAILURE; $(old_plist_note "$(legacy_plist_for "$id")")" ;;
      2) rollback_die "migration rolled back, but the new job \"$label\" could not be booted out again (or read back): both may be loaded, sharing one run.sh, so they end each other's session in turn until it goes (run: launchctl bootout gui/$(id -u)/$label); $(old_plist_note "$(legacy_plist_for "$id")"): $RENAME_FAILURE" ;;
      3) rollback_die "migration rolled back, but the old job \"$(legacy_label_for "$id")\" is not loaded: $RENAME_FAILURE" ;;
      *) rollback_die "migration rolled back (the new one is removed), but the old job \"$(legacy_label_for "$id")\" could not be read back, so it may not be loaded: $RENAME_FAILURE" ;;
    esac
    return 0
  fi
  launchd_reload "$plist" "$label" || die "launchctl bootstrap failed for $label (try: hoai-agent status --assistant $id)"
  ok "launchd service $label loaded"
  # An old plist of THIS HOME would load again at the next login, beside this
  # one, whoever holds the old label now (another HOME's job is not touched).
  if file_records_home "$(legacy_plist_for "$id")"; then
    rm -f "$(legacy_plist_for "$id")"
    service_note "removed $(legacy_plist_for "$id"), an old service file of this HOME that would start a second agent at the next login"
  fi
}

# --- Linux systemd --user ----------------------------------------------------
# One systemd Environment= line, quoted so a value with a space survives, with
# the three characters that would otherwise change its meaning escaped: \ and "
# (C-style escapes inside the quotes) and % (a unit specifier, written %%).
systemd_env_line() { # $1 name $2 value
  local v="$2"
  v="${v//\\/\\\\}"
  v="${v//\"/\\\"}"
  v="${v//%/%%}"
  printf 'Environment="%s=%s"\n' "$1" "$v"
}

install_systemd() { # $1 id $2 workdir $3 statedir $4 path [$5 claude config dir] [$6 service namespace] [$7 old name's state]
  local id="$1" workdir="$2" statedir="$3" path="$4" config_dir="${5:-}" namespace="${6:-}" legacy_state="${7:-absent}"
  local unit; unit="$(unit_for "$id")"
  local unitfile; unitfile="$(unitfile_for "$id")"
  local user_name; user_name="$(id -un)"
  ensure_user_bus
  local env_extra=""
  [ -n "$config_dir" ] && env_extra="$env_extra$(systemd_env_line CLAUDE_CONFIG_DIR "$config_dir")"$'\n'
  [ -n "$namespace" ] && env_extra="${env_extra}Environment=HOAI_SERVICE_NAMESPACE=$namespace"$'\n'
  mkdir -p "$HOME/.config/systemd/user"
  # StartLimitIntervalSec=0 → never give up restarting (matches launchd KeepAlive);
  # crash-loop visibility comes from run.sh, not from systemd marking it failed.
  # Logs go to $statedir/agent.log (run.sh redirects); journal captures the rest
  # (append: is avoided, it needs systemd v240+, breaking Ubuntu 18.04).
  cat > "$unitfile" <<UNIT
[Unit]
Description=BGOS Claude Code agent $id
StartLimitIntervalSec=0

[Service]
Type=simple
WorkingDirectory=$workdir
ExecStart=/bin/bash "$statedir/run.sh"
Restart=always
RestartSec=10
Environment=PATH=$path
Environment=HOME=$HOME
Environment=TERM=xterm-256color
Environment=USER=$user_name
Environment=LOGNAME=$user_name
Environment=CLAUDE_CODE_ENABLE_TODO_TOOLS=1
${env_extra}StandardOutput=journal
StandardError=journal

[Install]
WantedBy=default.target
UNIT
  # Asked BEFORE enable --now, which starts a stopped unit and does NOTHING to a
  # running one: a reinstall over a live agent (the watcher upgrading generation
  # 1, design section 5) left it on the run.sh it started with, run.expect and
  # no tmux, until something else restarted it. launchd_reload restarts by
  # construction (bootout, then bootstrap); this is the same promise on Linux.
  local was_active=0
  systemctl --user is-active --quiet "$unit" >/dev/null 2>&1 && was_active=1
  if [ "$legacy_state" = own ]; then
    systemd_rename "$id" "$unit" "$was_active"
    return 0
  fi
  # Round 2 L11: a rename drop-in an interrupted swap left (Conflicts= the old
  # unit) would let a later start of the old name stop this one.
  undo_rename_dropin "$HOME/.config/systemd/user/$unit.service.d"
  systemctl --user daemon-reload || die "systemctl --user daemon-reload failed"
  systemctl --user enable --now "$unit" || die "systemctl --user enable failed for $unit"
  if [ "$was_active" = 1 ]; then
    systemctl --user restart "$unit" || die "systemctl --user restart failed for $unit (the unit file is written; try: hoai-agent restart --assistant $id)"
    ok "systemd --user service $unit enabled + restarted onto the new supervisor"
  else
    ok "systemd --user service $unit enabled + started"
  fi
  # An old unit file of THIS HOME is removed so no later reload or login finds
  # it beside this one (another HOME's loaded unit is not touched).
  if file_records_home "$(legacy_unitfile_for "$id")"; then
    rm -f "$(legacy_unitfile_for "$id")"
    service_note "removed $(legacy_unitfile_for "$id"), an old service file of this HOME that would start a second agent at the next login"
  fi
}

# The rename of this HOME's OLD unit (before 0.69.4) to the HOME-scoped
# one, in #237's Linux order, never a moment without an enabled unit: a drop-in
# makes the new unit conflict with (and order after) the old one, the new unit
# is enabled (not started), the old one disabled (not stopped), then ONE
# `systemctl --user start` of the new unit: the user manager stops the old unit
# and starts the new one as a single job. An installer running inside the old
# unit's cgroup (a hoai-agent install typed into the agent's own session) dies
# when the old unit stops; the manager still finishes the job, so the agent
# comes back under the new name. A failed step enables and starts the old unit
# again and removes the new unit file, so nothing later acts on a new unit that
# does not run. The drop-in and the old unit file go once it is done.
undo_rename_dropin() { rm -f "$1/hoai-rename.conf"; rmdir "$1" 2>/dev/null || true; }
systemd_rename() { # $1 id $2 new unit $3 was the new unit active (1/0)
  local id="$1" unit="$2" was_active="$3" old dropdir
  old="$(legacy_unit_for "$id")"
  dropdir="$HOME/.config/systemd/user/$unit.service.d"
  mkdir -p "$dropdir"
  printf '# Written by bin/bgos-agent for the rename from the old unit; removed once it is done.\n[Unit]\nConflicts=%s.service\nAfter=%s.service\n' "$old" "$old" > "$dropdir/hoai-rename.conf"
  if ! systemctl --user daemon-reload || ! systemctl --user enable "$unit"; then
    undo_rename_dropin "$dropdir"; rm -f "$(unitfile_for "$id")"; systemctl --user daemon-reload >/dev/null 2>&1 || true
    rollback_die "systemctl --user enable failed for $unit; the old unit \"$old\" stays"
  fi
  if ! systemctl --user disable "$old"; then
    systemctl --user disable --now "$unit" >/dev/null 2>&1 || true
    undo_rename_dropin "$dropdir"; rm -f "$(unitfile_for "$id")"; systemctl --user daemon-reload >/dev/null 2>&1 || true
    rollback_die "migration rolled back (the new unit was disabled again, the old \"$old\" stays): systemctl --user disable $old failed"
  fi
  local swap=start
  [ "$was_active" = 1 ] && swap=restart
  if ! systemctl --user "$swap" "$unit"; then
    systemctl --user disable --now "$unit" >/dev/null 2>&1 || true
    restore_run_sh
    systemctl --user enable --now "$old" >/dev/null 2>&1 || true
    undo_rename_dropin "$dropdir"; rm -f "$(unitfile_for "$id")"; systemctl --user daemon-reload >/dev/null 2>&1 || true
    rollback_die "migration rolled back (the old unit \"$old\" is enabled and started again): systemctl --user $swap $unit failed"
  fi
  undo_rename_dropin "$dropdir"
  if file_records_home "$(legacy_unitfile_for "$id")"; then rm -f "$(legacy_unitfile_for "$id")"; fi
  systemctl --user daemon-reload >/dev/null 2>&1 || true
  ok "systemd --user service $unit enabled + started"
  service_note "renamed the systemd unit \"$old\" (installed from this HOME by an older version) to systemd unit \"$unit\""
}

# Agent activity hooks for a CLONE install.
#
# Claude Code reads a plugin's own hooks/hooks.json ONLY for an INSTALLED plugin
# under ~/.claude/plugins. This workspace is an MCP server entry in .mcp.json,
# not an installed plugin, so nothing here would ever read that file and the
# agent activity rail would simply never appear, with no error to notice. The
# workspace settings file IS read, so the same entries go there, pointed at this
# checkout's forwarder by absolute path. Idempotent: safe on every install and
# on every re-install. Best effort: a failure costs the tool detail, nothing else.
install_hook_entries() { # $1 workdir $2 plugin_dir [$3 "nofloor"]
  local workdir="$1" plugin_dir="$2" floor_mode="${3:-}"
  if ! command -v node >/dev/null 2>&1; then
    warn "node not found, skipping the activity hooks (the agent works, tool detail will not show)"
    return 0
  fi
  HOAI_PRESEED="$plugin_dir/lib/claude-preseed.mjs" \
  HOAI_SETTINGS="$workdir/.claude/settings.local.json" \
  HOAI_FORWARDER="$plugin_dir/bin/hoai-hook.mjs" \
  HOAI_NO_FLOOR="$([ "$floor_mode" = "nofloor" ] && echo 1 || echo 0)" \
  node -e '
    const { pathToFileURL } = require("node:url");
    import(pathToFileURL(process.env.HOAI_PRESEED).href)
      .then((m) => m.ensureHookEntries({
        settingsPath: process.env.HOAI_SETTINGS,
        forwarderPath: process.env.HOAI_FORWARDER,
        // A workspace that never carried the hooks gets the rail and the
        // private turn hook, not a floor it never had (a held action on an
        // unattended agent is a decision for the owner, not for an update).
        ...(process.env.HOAI_NO_FLOOR === "1" ? { floorHookPath: null } : {}),
      }))
      .catch((err) => { process.stderr.write(String(err) + "\n"); process.exitCode = 1; });
  ' 2>/dev/null \
    && ok "activity hooks registered in $workdir/.claude/settings.local.json" \
    || warn "could not register the activity hooks (the agent works, tool detail will not show)"
}

# Deny the Claude Code tools that stop an unattended session at a terminal
# prompt (AskUserQuestion: the agent waits for a keypress nobody will press
# while its daemon still reports online). Both bootstraps write this at first
# install, which is the problem: an agent installed before the deny existed
# never gets it. This runs on install AND on restart.
#
# Deliberately NOT inside install_hook_entries, and not behind that function's
# gate. refresh_hook_entries only touches a workspace that already names
# hoai-hook.mjs, because stacking a second hook entry on a workspace that gets
# its hooks elsewhere would leave a dead one firing. A permission cannot
# duplicate anything, so it must not inherit that condition.
#
# Best effort: a failure costs one tool staying allowed, never the install.
install_denied_tools() { # $1 workdir $2 plugin_dir
  local workdir="$1" plugin_dir="$2"
  if ! command -v node >/dev/null 2>&1; then
    warn "node not found, skipping the tool deny (an unattended session could stop on a question)"
    return 0
  fi
  HOAI_PRESEED="$plugin_dir/lib/claude-preseed.mjs" \
  HOAI_SETTINGS="$workdir/.claude/settings.local.json" \
  node -e '
    const { pathToFileURL } = require("node:url");
    import(pathToFileURL(process.env.HOAI_PRESEED).href)
      .then((m) => m.ensureDeniedTools({ settingsPath: process.env.HOAI_SETTINGS }))
      .catch((err) => { process.stderr.write(String(err) + "\n"); process.exitCode = 1; });
  ' 2>/dev/null \
    && ok "terminal-only tools denied in $workdir/.claude/settings.local.json" \
    || warn "could not write the tool deny (an unattended session could stop on a question)"
}

say_launch_hint() { # $1 workdir $2 channel
  echo
  ok "Config ready (no supervisor, foreground mode)."
  # CLAUDE_CODE_ENABLE_TODO_TOOLS=1 turns on the CLI's task tools, which is what
  # feeds the live Steps strip in the app. The rest of the activity rail works
  # without it.
  printf '  Run it with:\n    cd %s\n    CLAUDE_CODE_ENABLE_TODO_TOOLS=1 claude --dangerously-skip-permissions --dangerously-load-development-channels %s\n' "$1" "$2"
  printf '  Re-run with %s--always-on%s to keep it running + survive reboot.\n' "$B" "$Z"
}

# =============================================================================
# status / start / stop / restart / logs / uninstall
# =============================================================================
# Marks one listed agent job or unit by the HOME its name carries: one launchd
# domain and one user manager per account list every HOME's agents.
LIST_MARK='function mark(name) {
  sub(/\.service$/, "", name)
  if (name !~ /[.-]home-[0-9a-f]+$/) return "  (old name, before 0.69.4: its HOME is not in its name)"
  if (hid == "") return "  (this HOME id could not be computed)"
  if (name ~ ("[.-]home-" hid "$")) return "  (this HOME)"
  return "  (another HOME)"
}'
cmd_status() {
  if [ -z "${ASSISTANT_ID:-}" ]; then
    info "BGOS agents on this host:"
    compute_home_id || true
    case "$OS" in
      Darwin) launchctl list 2>/dev/null | awk -v hid="$HOME_ID" "$LIST_MARK"' $3 ~ /^ai\.bgos\.agent\./ {print "  "$0 mark($3)}' | grep . || echo "  (none)";;
      Linux)  ensure_user_bus; systemctl --user list-units --all 'bgos-agent-*' --no-legend 2>/dev/null | awk -v hid="$HOME_ID" "$LIST_MARK"' { n = $1; if (n !~ /^bgos-agent-/) n = $2; print $0 mark(n) }' | grep . || echo "  (none)";;
    esac
    return 0
  fi
  require_id
  local statedir; statedir="$(statedir_for "$ASSISTANT_ID")"
  # Read back first (board row d6198bb6): this HOME's own registration, or while
  # the agent is not renamed yet its OLD one when that is this HOME's. Another
  # HOME's is never shown as this HOME's.
  need_home_id
  [ "$OS" = Linux ] && ensure_user_bus
  probe_service "$ASSISTANT_ID" own
  local own_state="$PROBE_STATE" own_say="$PROBE_SAY" shown=""
  probe_service "$ASSISTANT_ID" legacy
  local old_state="$PROBE_STATE" old_say="$PROBE_SAY"
  case "$own_state" in
    own) shown=own ;;
    foreign|unknown) warn "${own_say#refused: }" ;;
    *) [ "$old_state" = own ] && shown=legacy ;;
  esac
  case "$OS" in
    Darwin)
      local label; label="$(label_for "$ASSISTANT_ID")"
      [ "$shown" = legacy ] && label="$(legacy_label_for "$ASSISTANT_ID")"
      if [ -n "$shown" ]; then
        ok "$label is loaded"
        [ "$shown" = legacy ] && info "$label was installed from this HOME by an older version; the next install renames it to $(label_for "$ASSISTANT_ID")"
        # Columns: PID  LAST-EXIT  LABEL. Warn when not running + last exit nonzero.
        launchctl list 2>/dev/null | awk -v l="$label" '$3==l {
          print "  pid="$1"  last-exit="$2;
          if ($1=="-" && $2!="0") print "  ! not running and last exit was nonzero, check logs"
        }'
      else warn "$label is not loaded (install with: hoai-agent install --assistant $ASSISTANT_ID --always-on)"; fi
      ;;
    Linux)
      local unit; unit="$(unit_for "$ASSISTANT_ID")"
      [ "$shown" = legacy ] && unit="$(legacy_unit_for "$ASSISTANT_ID")"
      if [ -n "$shown" ]; then
        [ "$shown" = legacy ] && info "$unit was installed from this HOME by an older version; the next install renames it to $(unit_for "$ASSISTANT_ID")"
        systemctl --user status "$unit" --no-pager || true
      else warn "$unit is not loaded (install with: hoai-agent install --assistant $ASSISTANT_ID --always-on)"; fi
      ;;
  esac
  case "$old_state" in
    foreign|unknown) service_note "$old_say" ;;
  esac
  # Which supervisor this is, and whether the agent sits in its tmux session:
  # that session is what remote /compact types into (finding 8).
  if [ -f "$statedir/supervisor-generation" ]; then
    info "supervisor generation $(cat "$statedir/supervisor-generation" 2>/dev/null) (hoai, resumes the agent's pinned session)"
  elif [ -f "$statedir/run.sh" ]; then
    warn "supervisor generation 1 (starts a fresh session, no tmux): reinstall with --always-on to upgrade"
  fi
  local sock; sock="$(tmux_name_for "$ASSISTANT_ID")"
  [ "$shown" = legacy ] && sock="$(legacy_tmux_name_for "$ASSISTANT_ID")"
  if ! command -v tmux >/dev/null 2>&1; then
    warn "tmux is not installed: the agent runs without a tmux session, remote compact OFF (reason: no-tmux)"
  elif tmux -L "$sock" has-session -t "=$sock" >/dev/null 2>&1; then
    ok "tmux session $sock is up: remote compact ON (watch it: hoai-agent attach --assistant $ASSISTANT_ID)"
  else
    warn "tmux session $sock is not running: remote compact OFF until the agent runs in it"
  fi
  # A unit that is installed and loaded is not an agent that is up. A crash loop (a
  # claude too old for the launch flag exited rc=1 about 420 times on kc-server and
  # every line above still read as healthy, board row 84296679) is named here, from
  # the same two files run.sh and hoai write, before the generic last-launch line.
  local fails last
  fails="$(cat "$statedir/failcount" 2>/dev/null || echo 0)"
  case "$fails" in ''|*[!0-9]*) fails=0 ;; esac
  last="$(cat "$statedir/launch-status" 2>/dev/null || true)"
  case "$last" in
    *outcome=exited-during-startup*|*outcome=plugin-root-missing*|*outcome=node-missing*|*outcome=gate-*|*outcome=live-but-not-signed-in*)
      warn "NOT RUNNING HEALTHY: the last launch did not come up ($fails consecutive fast fail(s)): $last"
      ;;
    *)
      if [ "$fails" -ge 3 ]; then
        warn "NOT RUNNING HEALTHY: $fails consecutive fast fails, this agent is crash looping. Last launch: ${last:-unknown}"
      fi
      ;;
  esac
  # How the most recent launch went, as hoai measured it (which startup gates
  # it answered, the screen it could not answer, or why it refused), or what
  # run.sh saw before hoai ran (a missing plugin root, no tmux).
  if [ -f "$statedir/launch-status" ]; then
    echo; info "last launch: $(cat "$statedir/launch-status")"
  fi
  if [ -f "$statedir/agent.log" ]; then
    echo; info "recent agent.log:"; tail -n 10 "$statedir/agent.log" || true
  fi
}

# After resolve_target: the label, unit and service file the command acts on.
# The OLD name only when it is loaded and proven this HOME's (an agent not
# renamed yet); this HOME's own name otherwise. An old name is never LOADED
# anew: the label and unit are one per account, so a HOME that bootstrapped its
# leftover old plist would take the name from whichever HOME's agent runs under
# it. T_RENAME_HINT says what to run instead when only this HOME's old file is
# there.
target_names() { # $1 id -> T_LABEL T_UNIT T_FILE T_RENAME_HINT
  local id="$1" own_file old_file
  case "$OS" in
    Darwin) own_file="$(plist_for "$id")"; old_file="$(legacy_plist_for "$id")" ;;
    *)      own_file="$(unitfile_for "$id")"; old_file="$(legacy_unitfile_for "$id")" ;;
  esac
  T_RENAME_HINT=""
  if [ "$SVC_TARGET" = legacy ]; then
    T_LABEL="$(legacy_label_for "$id")"; T_UNIT="$(legacy_unit_for "$id")"; T_FILE="$old_file"
  else
    T_LABEL="$(label_for "$id")"; T_UNIT="$(unit_for "$id")"; T_FILE="$own_file"
    if [ ! -f "$own_file" ] && [ -f "$old_file" ]; then
      T_RENAME_HINT="agent $id's service is installed under its old name and not loaded; run: hoai-agent install --assistant $id --always-on (it renames it to $([ "$OS" = Darwin ] && echo "$T_LABEL" || echo "$T_UNIT") and starts it)"
    fi
  fi
}

cmd_stop() {
  require_id
  [ "$OS" = Linux ] && ensure_user_bus
  resolve_target "$ASSISTANT_ID" die
  target_names "$ASSISTANT_ID"
  case "$OS" in
    Darwin) launchctl bootout "gui/$(id -u)/$T_LABEL" >/dev/null 2>&1 && ok "stopped $T_LABEL" || warn "was not running";;
    Linux)  systemctl --user stop "$T_UNIT" && ok "stopped" || warn "was not running";;
  esac
}

cmd_start() {
  require_id
  [ "$OS" = Linux ] && ensure_user_bus
  resolve_target "$ASSISTANT_ID" die
  target_names "$ASSISTANT_ID"
  case "$OS" in
    Darwin)
      [ -z "$T_RENAME_HINT" ] || die "$T_RENAME_HINT"
      [ -f "$T_FILE" ] || die "not installed, run: hoai-agent install --assistant $ASSISTANT_ID --always-on"
      launchd_reload "$T_FILE" "$T_LABEL" && ok "started" || die "could not start $T_LABEL";;
    Linux)
      [ -z "$T_RENAME_HINT" ] || die "$T_RENAME_HINT"
      systemctl --user start "$T_UNIT" && ok "started" || die "could not start $T_UNIT";;
  esac
}

cmd_restart() {
  require_id
  [ "$OS" = Linux ] && ensure_user_bus
  resolve_target "$ASSISTANT_ID" die
  target_names "$ASSISTANT_ID"
  case "$OS" in
    Darwin)
      [ -z "$T_RENAME_HINT" ] || die "$T_RENAME_HINT"
      [ -f "$T_FILE" ] || die "not installed"
      launchd_reload "$T_FILE" "$T_LABEL" && ok "restarted" || die "restart failed";;
    Linux)
      [ -z "$T_RENAME_HINT" ] || die "$T_RENAME_HINT"
      systemctl --user restart "$T_UNIT" && ok "restarted" || die "restart failed for $T_UNIT";;
  esac
}

# Re-register a CLONE workspace's hook entries after an update, before its
# service restarts. The CLI reads a clone's hooks only from the workspace
# settings file, and only install writes it, so an update that grows the list
# (0.53.0 added the BLOCKING floor hook) reached an always-on agent's checkout
# but never its session: the daemon then had no floor to declare, and without
# this the unattended, full access agent was the one with no floor. Only a
# workspace that already carries the rail is touched (a marketplace channel's
# hooks come from its own hooks file, and its settings carry no hoai-hook
# entry). Best effort: install_hook_entries never fails the update.
# Is this workspace a CLONE workspace of THIS checkout? Its .mcp.json names a
# `bgos` server whose server.ts lives in this plugin dir (compared by real path:
# /Users/fitecho and /Users/bgos are one directory on KC's Mac, and the
# .mcp.json may spell either). Only then does the CLI read its hooks from the
# workspace settings file and nowhere else, which is the case a refresh must
# cover even when the folder never carried a hoai-hook entry (board bbbf3438:
# 0.67.0 gated private tools on a hook such a folder never had).
workdir_names_this_clone() { # $1 workdir $2 plugin_dir
  local mcp="$1/.mcp.json" server real_server real_plugin
  [ -f "$mcp" ] || return 1
  command -v node >/dev/null 2>&1 || return 1
  server="$(HOAI_MCP="$mcp" node -e '
    try {
      const d = JSON.parse(require("fs").readFileSync(process.env.HOAI_MCP, "utf8"));
      const s = d && d.mcpServers && d.mcpServers.bgos;
      const arg = s && Array.isArray(s.args) ? s.args.find((a) => typeof a === "string" && a.endsWith("server.ts")) : "";
      process.stdout.write(arg || "");
    } catch {}
  ' 2>/dev/null)"
  [ -n "$server" ] || return 1
  real_server="$(cd -P "$(dirname "$server")" 2>/dev/null && pwd)" || return 1
  real_plugin="$(cd -P "$2" 2>/dev/null && pwd)" || return 1
  [ "$real_server" = "$real_plugin" ]
}

# Register a clone workspace's hooks after an update WITHOUT a restart: for an
# agent whose supervisor is not bgos-agent's (a keepalive launchd job, a
# watchdog). The CLI reads hooks at launch, so the owner restarts it after.
register_hooks_for_clone_workdir() { # $1 workdir
  local workdir="$1"
  [ -n "$(plugin_cache_key "$PLUGIN_DIR")" ] && return 0
  workdir_names_this_clone "$workdir" "$PLUGIN_DIR" || return 0
  local settings="$workdir/.claude/settings.local.json" floor_mode="nofloor"
  # A folder that already carries the rail keeps its full set, floor included.
  if [ -f "$settings" ] && grep -q 'hoai-hook\.mjs' "$settings"; then floor_mode=""; fi
  install_hook_entries "$workdir" "$PLUGIN_DIR" "$floor_mode"
}

refresh_hook_entries() { # $1 assistant id
  local id="$1" service_file="" workdir=""
  case "$OS" in
    Darwin)
      service_file="$(plist_for "$id")"
      [ -f "$service_file" ] || service_file="$(legacy_plist_for "$id")"
      [ -f "$service_file" ] && workdir="$(sed -n 's:.*<key>WorkingDirectory</key><string>\(.*\)</string>.*:\1:p' "$service_file" | head -n 1 \
        | sed -e 's/&lt;/</g' -e 's/&gt;/>/g' -e 's/&quot;/"/g' -e "s/&apos;/'/g" -e 's/&amp;/\&/g')"
      ;;
    Linux)
      service_file="$(unitfile_for "$id")"
      [ -f "$service_file" ] || service_file="$(legacy_unitfile_for "$id")"
      [ -f "$service_file" ] && workdir="$(sed -n 's/^WorkingDirectory=//p' "$service_file" | head -n 1)"
      ;;
  esac
  [ -n "$workdir" ] || workdir="$(default_workdir_for "$id")"
  local settings="$workdir/.claude/settings.local.json"
  # The deny first, and ungated: it is a permission, not a hook, so it cannot
  # stack a duplicate and every agent folder wants it. Only a workdir that
  # already has a .claude directory is touched, so a restart never invents
  # configuration for a folder that has none.
  if [ -d "$workdir/.claude" ]; then
    install_denied_tools "$workdir" "$PLUGIN_DIR"
  fi
  if [ -f "$settings" ] && grep -q 'hoai-hook\.mjs' "$settings"; then
    install_hook_entries "$workdir" "$PLUGIN_DIR"
  else
    # No hoai-hook entry yet: a clone workspace still needs the private turn
    # hook, or every boards, schedule and browser call refuses.
    register_hooks_for_clone_workdir "$workdir"
  fi
}

# Restart an installed supervisor after an update. Updating the checkout has
# already succeeded by this point, so a missing or unreachable service is a
# warning, never an update failure.
restart_after_update() { # $1 assistant id
  local id="$1"
  # The update itself has already succeeded: without a HOME id (no bun or node
  # answers the helper) no service is named, so none is restarted, by name.
  if ! compute_home_id; then
    warn "agent $id was not restarted: its service is named after this HOME and the HOME id could not be computed ($AGENT_SERVICE_JS runs on bun or node); quit and relaunch Claude Code"
    return 0
  fi
  refresh_hook_entries "$id"
  [ "$OS" = Linux ] && export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  # Read back first: a service under this HOME's name that another HOME
  # installed is not restarted (and the update goes on with the next agent).
  if ! resolve_target "$id" warn; then
    warn "agent $id was not restarted; quit and relaunch Claude Code"
    return 0
  fi
  target_names "$id"
  if [ -n "$T_RENAME_HINT" ]; then
    warn "agent $id was not restarted: $T_RENAME_HINT"
    return 0
  fi
  case "$OS" in
    Darwin)
      if [ ! -f "$T_FILE" ]; then
        warn "agent $id has no installed service; quit and relaunch Claude Code"
      elif launchd_reload "$T_FILE" "$T_LABEL"; then
        ok "restarted agent $id"
      else
        warn "could not restart agent $id; quit and relaunch Claude Code"
      fi
      ;;
    Linux)
      if [ ! -f "$T_FILE" ]; then
        warn "agent $id has no installed service; quit and relaunch Claude Code"
      else
        if systemctl --user restart "$T_UNIT"; then
          ok "restarted agent $id"
        else
          warn "could not restart agent $id; quit and relaunch Claude Code"
        fi
      fi
      ;;
    *) warn "could not restart agent $id on $OS; quit and relaunch Claude Code" ;;
  esac
}

# =============================================================================
# update
# =============================================================================
cmd_update() {
  command -v git >/dev/null 2>&1 || die "git not found, install it first"
  command -v bun >/dev/null 2>&1 || die "bun not found, install from https://bun.sh"
  [ -e "$PLUGIN_DIR/.git" ] \
    || die "plugin at $PLUGIN_DIR is not a git checkout, reinstall with hoai-agent install"

  if [ -n "${ASSISTANT_ID:-}" ]; then
    valid_id "$ASSISTANT_ID" || die "--assistant must be a positive integer"
  fi

  local BEFORE AFTER branch dirty
  BEFORE="$(bun -e '
    const pkg = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
    process.stdout.write(pkg.version);
  ' "$PLUGIN_DIR/package.json")" \
    || die "could not read plugin version from $PLUGIN_DIR/package.json"
  # The re-executed script reads the already updated package.json, so the
  # version the update started from rides in the environment.
  BEFORE="${HOAI_UPDATE_FROM_VERSION:-$BEFORE}"

  dirty="$(git -C "$PLUGIN_DIR" status --porcelain)" \
    || die "could not inspect the plugin checkout at $PLUGIN_DIR"
  [ -z "$dirty" ] \
    || die "the plugin checkout has local changes, not overwriting; resolve them in $PLUGIN_DIR or reinstall"

  branch="$(git -C "$PLUGIN_DIR" rev-parse --abbrev-ref HEAD)" \
    || die "could not determine the plugin checkout branch"
  if [ -z "$branch" ] || [ "$branch" = "HEAD" ]; then branch="main"; fi

  if [ "${HOAI_UPDATE_REEXEC:-}" != "1" ]; then
    info "Fetching origin/$branch"
    git -C "$PLUGIN_DIR" fetch --depth 1 origin "$branch" \
      || die "could not fetch origin/$branch; the plugin checkout was not changed"
    git -C "$PLUGIN_DIR" reset --hard "origin/$branch" \
      || die "could not update the plugin checkout to origin/$branch"
    # THE RESET JUST REPLACED THIS SCRIPT. The rest of this function is the OLD
    # code the shell already read, so everything below (the hook registration
    # that 0.67.2 added, the restart) would run as it was before the pull and a
    # fix shipped in the update would take a second update to apply (seen on
    # KC's Mac, 2026-10-12: the first `bgos-agent update` to 0.67.2 registered
    # nothing). Hand over to the new file for the rest of the update; the
    # environment says the pull is done so it does not fetch again.
    if [ -f "$SELF" ]; then
      local reexec=(update)
      [ -n "${ASSISTANT_ID:-}" ] && reexec+=(--assistant "$ASSISTANT_ID")
      info "Continuing with the updated script"
      HOAI_UPDATE_REEXEC=1 HOAI_UPDATE_FROM_VERSION="$BEFORE" exec "$SELF" "${reexec[@]}"
    fi
  fi

  info "Installing plugin deps (bun install)"
  ( cd "$PLUGIN_DIR" && bun install --no-summary >/dev/null 2>&1 ) \
    || warn "bun install reported an issue (continuing)"
  install_daemon_wrapper

  AFTER="$(bun -e '
    const pkg = JSON.parse(require("fs").readFileSync(process.argv[1], "utf8"));
    process.stdout.write(pkg.version);
  ' "$PLUGIN_DIR/package.json")" \
    || die "could not read plugin version from $PLUGIN_DIR/package.json"
  if [ "$BEFORE" = "$AFTER" ]; then
    ok "already up to date at $AFTER"
  else
    ok "plugin updated: $BEFORE -> $AFTER"
  fi

  if [ -n "${ASSISTANT_ID:-}" ]; then
    restart_after_update "$ASSISTANT_ID"
    return 0
  fi

  local state_dir id service_file installed=0
  # Without a HOME id service_file_for still finds this HOME's files, old and renamed, and restart_after_update says why it restarts none.
  compute_home_id || true
  for state_dir in "$STATE_ROOT"/[0-9]*; do
    [ -d "$state_dir" ] || continue
    id="${state_dir##*/}"
    valid_id "$id" || continue
    case "$OS" in
      Darwin|Linux) service_file="$(service_file_for "$id")" ;;
      *)      continue ;;
    esac
    if [ -z "$service_file" ]; then
      # An agent kept alive by another supervisor (a keepalive job, a watchdog)
      # declares its folder in service.json. Register its hooks; it restarts
      # through its own supervisor, which the owner or the watcher drives.
      local declared=""
      if [ -f "$state_dir/service.json" ] && command -v node >/dev/null 2>&1; then
        declared="$(HOAI_SVC="$state_dir/service.json" node -e '
          try { process.stdout.write(String(JSON.parse(require("fs").readFileSync(process.env.HOAI_SVC, "utf8")).cwd || "")); } catch {}
        ' 2>/dev/null)"
      fi
      if [ -n "$declared" ] && [ -d "$declared" ]; then
        register_hooks_for_clone_workdir "$declared"
        info "agent $id: hooks checked in $declared (restart it to load them)"
      fi
      continue
    fi
    installed=1
    restart_after_update "$id"
  done
  if [ "$installed" -eq 0 ]; then
    warn "no installed agent services found; quit and relaunch Claude Code to use the update"
  fi
}

cmd_logs() {
  require_id
  local statedir; statedir="$(statedir_for "$ASSISTANT_ID")"
  [ -d "$statedir" ] || die "no state for agent $ASSISTANT_ID"
  # Only the logs that exist: generation 2 writes no expect.log (hoai runs in
  # tmux, see hoai-agent attach), and a missing file made tail fail, which then
  # printed "no logs yet" right under the log it had just shown. A generation 1
  # supervisor not yet upgraded still has its expect.log. hoai.err is hoai's own
  # stderr in tmux, copied into agent.log only when the session ends, so a
  # running launch's is shown when it has anything in it.
  local logs=() f
  for f in "$statedir/agent.log" "$statedir/expect.log"; do
    if [ -f "$f" ]; then logs+=("$f"); fi
  done
  if [ -s "$statedir/hoai.err" ]; then logs+=("$statedir/hoai.err"); fi
  if [ "${#logs[@]}" -eq 0 ]; then echo "(no logs yet)"; return 0; fi
  tail -n 60 "${logs[@]}"
}

# Look at the agent's own terminal: its tmux session on its own socket. Typing
# there reaches claude exactly as it would in a terminal window.
cmd_attach() {
  require_id
  need_home_id
  local sock; sock="$(tmux_name_for "$ASSISTANT_ID")"
  command -v tmux >/dev/null 2>&1 \
    || die "tmux is not installed here, so agent $ASSISTANT_ID runs without a tmux session (remote compact is off). Install tmux, then: hoai-agent restart --assistant $ASSISTANT_ID"
  if ! tmux -L "$sock" has-session -t "=$sock" >/dev/null 2>&1; then
    # An agent not renamed yet runs on its OLD socket: attached to only when its
    # service is proven this HOME's (another HOME's agent of the same id has one too).
    local old; old="$(legacy_tmux_name_for "$ASSISTANT_ID")"
    [ "$OS" = Linux ] && export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
    probe_service "$ASSISTANT_ID" legacy
    if [ "$PROBE_STATE" = own ] && tmux -L "$old" has-session -t "=$old" >/dev/null 2>&1; then
      sock="$old"
    else
      die "agent $ASSISTANT_ID has no tmux session right now (stopped, waiting to take over from a session in its folder, or started without tmux). See: hoai-agent status --assistant $ASSISTANT_ID"
    fi
  fi
  info "attaching to $sock. Detach with Ctrl-b then d; typing /exit ends the agent (its service starts it again)."
  exec tmux -L "$sock" attach -t "=$sock"
}

# Remove an agent's supervisor state but KEEP its pinned session id (finding 7).
# The pin is hoai's, not the supervisor's: removing it would make the next launch
# (by hand, or a supervisor installed again later) start a brand new conversation.
remove_state_keep_pin() { # $1 statedir
  local dir="$1" entry
  [ -d "$dir" ] || return 0
  if [ ! -f "$dir/session-id" ]; then
    rm -rf "$dir"
    return 0
  fi
  for entry in "$dir"/* "$dir"/.[!.]* "$dir"/..?*; do
    [ -e "$entry" ] || [ -L "$entry" ] || continue
    [ "$entry" = "$dir/session-id" ] && continue
    rm -rf "$entry"
  done
}

# End the agent's own tmux server. Only its socket (this HOME's), never another
# server; the OLD socket only when asked, once its service was proven this HOME's.
kill_agent_tmux() { # $1 assistant id [$2 1: the old socket too]
  command -v tmux >/dev/null 2>&1 || return 0
  if [ -n "$HOME_ID" ]; then tmux -L "$(tmux_name_for "$1")" kill-server >/dev/null 2>&1 || true; fi
  if [ "${2:-0}" = 1 ]; then tmux -L "$(legacy_tmux_name_for "$1")" kill-server >/dev/null 2>&1 || true; fi
}

cmd_uninstall() {
  require_id
  local statedir; statedir="$(statedir_for "$ASSISTANT_ID")"
  # The install lock, taken here too: an install of this agent still running
  # would write run.sh and the service file while they are removed below,
  # leaving a loaded job with no run.sh, and while this uninstall holds the lock
  # a new install stands down. It waits for such an install, but never refuses:
  # always-on was switched off, so after UNINSTALL_LOCK_WAIT_S it goes ahead
  # anyway (the daemon gives an uninstall 60 seconds).
  local waited=0
  until acquire_install_lock "$ASSISTANT_ID"; do
    if [ "$waited" -ge "$UNINSTALL_LOCK_WAIT_S" ]; then
      warn "an install of agent $ASSISTANT_ID still holds $(install_lock_for "$ASSISTANT_ID") after ${waited}s; uninstalling anyway"
      break
    fi
    [ "$waited" -eq 0 ] && info "waiting for an install of agent $ASSISTANT_ID to finish (up to ${UNINSTALL_LOCK_WAIT_S}s)"
    sleep 1
    waited=$((waited + 1))
  done
  # Read back first (board row d6198bb6), before anything is removed: this
  # HOME's own name recording ANOTHER HOME is refused and nothing at all is
  # removed (no purge). So is one that cannot be read back, and one that cannot
  # be named (no bun or node runs the helper) (round 2 L8): removing the files
  # of a job that cannot be stopped by name would leave the agent running, kept
  # alive, while this says it was removed. The OLD name (before 0.69.4) is
  # stopped only when it is proven this HOME's; another HOME's is left alone and
  # said.
  local own_state="unknown" old_state="unknown"
  [ "$OS" = Linux ] && export XDG_RUNTIME_DIR="${XDG_RUNTIME_DIR:-/run/user/$(id -u)}"
  if ! compute_home_id; then
    die "refused: agent $ASSISTANT_ID's service could not be named (no bun or node runs $AGENT_SERVICE_JS), so it could not be stopped; nothing was removed. Install bun or Node.js 18 or newer, then run this again."
  fi
  probe_service "$ASSISTANT_ID" own
  own_state="$PROBE_STATE"
  case "$own_state" in
    foreign) die "$PROBE_SAY; nothing was removed" ;;
    unknown) die "refused: agent $ASSISTANT_ID's service could not be read back, so it could not be stopped by name (${PROBE_SAY#refused: }); nothing was removed" ;;
  esac
  probe_service "$ASSISTANT_ID" legacy
  old_state="$PROBE_STATE"
  case "$old_state" in
    foreign) service_note "$PROBE_SAY" ;;
    unknown)
      # The old job may be this HOME's: its files would go while it runs on (round 2 L8).
      if file_records_home "$(legacy_service_file_for "$ASSISTANT_ID")"; then
        die "refused: agent $ASSISTANT_ID's old service could not be read back (${PROBE_SAY#left the }) and this HOME's old service file $(legacy_service_file_for "$ASSISTANT_ID") is there, so it may be running and could not be stopped by name; nothing was removed"
      fi
      service_note "$PROBE_SAY" ;;
  esac
  # Remove the manifest + state FIRST, so the agent reads as uninstalled even if
  # the stop/bootout below kills this very process, which happens when the
  # toggle is flipped off from INSIDE the supervised session (the teardown is a
  # descendant of the job, and of its tmux server). Killing the tmux server
  # first would end this process before the plist is gone, and launchd would
  # bring the agent straight back. Workspace + .mcp.json are a sibling dir,
  # never touched; the pinned session id is kept (remove_state_keep_pin). This
  # HOME's old service file goes when it records this HOME.
  local own_file="" old_file=""
  case "$OS" in
    Darwin) own_file="$(plist_for "$ASSISTANT_ID")"; old_file="$(legacy_plist_for "$ASSISTANT_ID")" ;;
    Linux)  own_file="$(unitfile_for "$ASSISTANT_ID")"; old_file="$(legacy_unitfile_for "$ASSISTANT_ID")" ;;
  esac
  [ -n "$own_file" ] && rm -f "$own_file"
  if [ -n "$old_file" ] && { [ "$old_state" = own ] || file_records_home "$old_file"; }; then rm -f "$old_file"; fi
  remove_state_keep_pin "$statedir"
  ok "removed supervisor manifest + state for agent $ASSISTANT_ID (its pinned session id is kept)"
  # Now stop the running job by label/unit (works even though the file is gone).
  # run.sh's trap ends the agent's tmux server on the way out. This may
  # terminate this process tree, fine, the cleanup above already ran.
  case "$OS" in
    Darwin)
      launchctl bootout "gui/$(id -u)/$(label_for "$ASSISTANT_ID")" >/dev/null 2>&1 || true
      if [ "$old_state" = own ]; then
        service_note "removed the launchd job \"$(legacy_label_for "$ASSISTANT_ID")\" (installed from this HOME by an older version)"
        launchctl bootout "gui/$(id -u)/$(legacy_label_for "$ASSISTANT_ID")" >/dev/null 2>&1 || true
      fi ;;
    Linux)
      systemctl --user stop "$(unit_for "$ASSISTANT_ID")" >/dev/null 2>&1 || true
      if [ "$old_state" = own ]; then
        service_note "removed the systemd unit \"$(legacy_unit_for "$ASSISTANT_ID")\" (installed from this HOME by an older version)"
        systemctl --user stop "$(legacy_unit_for "$ASSISTANT_ID")" >/dev/null 2>&1 || true
      fi
      systemctl --user daemon-reload >/dev/null 2>&1 || true ;;
  esac
  # And the agent's own tmux server, in case no run.sh was there to trap the stop
  # (one killed with SIGKILL leaves its server behind).
  local old_tmux=0
  [ "$old_state" = own ] && old_tmux=1
  kill_agent_tmux "$ASSISTANT_ID" "$old_tmux"
  info "Always-on removed. The plugin ($PLUGIN_DIR) and your workspace + .mcp.json are kept."
}

cmd_is_installed() { # exit 0 if the supervisor is installed for this id, else 1
  require_id
  # This HOME's service file under its own name, or the OLD one of an agent
  # not renamed yet (a file test, as it always was: no service is asked).
  compute_home_id || true
  case "$OS" in
    Darwin|Linux) [ -n "$(service_file_for "$ASSISTANT_ID")" ] && exit 0 || exit 1 ;;
    *) exit 1 ;;
  esac
}

cmd_link() {
  mkdir -p "$HOME/.local/bin"
  ln -sf "$SELF" "$HOME/.local/bin/hoai-agent"
  ln -sf "$SELF" "$HOME/.local/bin/bgos-agent"
  # hoai is the bash dispatcher next to this script; it must reach hoai-core.mjs.
  ln -sf "$BIN_DIR/hoai" "$HOME/.local/bin/hoai"
  ok "linked → $HOME/.local/bin/hoai-agent"
  case ":$PATH:" in
    *":$HOME/.local/bin:"*) : ;;
    *) warn "add ~/.local/bin to PATH:  export PATH=\"\$HOME/.local/bin:\$PATH\"";;
  esac
}

usage() {
  cat <<USAGE
${B}hoai-agent${Z} v$VERSION, set up + keep alive a BGOS Claude Code agent.

${B}Commands${Z}
  pair      <CODE> [--backend <url>]  pair with a one time code from the HOAI app (recommended)
  doctor    [args]                    diagnose this host's HOAI agent setup
  install   --assistant <id> [opts]   set up the agent (and supervisor with --always-on)
  status    [--assistant <id>]        show service state (+ recent log); no id = list all
  start | stop | restart  --assistant <id>
  logs      --assistant <id>          tail the agent's logs
  attach    --assistant <id>          watch (and type into) the agent's tmux session
  uninstall --assistant <id>          remove the supervisor + state (keeps plugin + workspace)
  is-installed --assistant <id>       exit 0 if the always-on supervisor is installed (for scripts)
  update    [--assistant <id>]         update the plugin and restart installed agents
  link                                symlink this script to ~/.local/bin
  help

${B}install options${Z}
  --assistant <id>     (required) BGOS assistant id
  --key <api-key>      BGOS_API_KEY        --user <user-id>   BGOS_USER_ID
  --openai-key <key>   BGOS_OPENAI_API_KEY, enables live voice calls (Talk button)
  --backend <url>      default $DEFAULT_BACKEND
  --dir <path>         working dir (default ~/.bgos-agent/<id>-workspace)
  --always-on          install the auto-restart + survive-reboot supervisor
  --continue           accepted for compatibility: the supervisor always resumes the
                       agent's OWN pinned session (never claude --continue)
  --auto-approve <t/f> default true
  --channel <name>     dev channel (default $DEFAULT_CHANNEL; advanced/testing)
  --no-clone           assume the plugin is already at \$BGOS_PLUGIN_DIR

${B}examples${Z}
  hoai-agent pair BGOS-7F3A-2K
  hoai-agent install --assistant 42 --key sk_... --user user_abc --always-on
  hoai-agent status --assistant 42
  hoai-agent uninstall --assistant 42
USAGE
}

# =============================================================================
# pair, exchange a one time code for a pairing token (no raw API key). Hands
# off to the node installer bin/bgos-pair.mjs, which writes the pairing token to
# ~/.bgos-agent/credentials.json (0600); server.ts reads it and sends
# X-BGOS-Pairing. This is the recommended auth path; --key/--user is legacy.
# =============================================================================
cmd_pair() {
  command -v node >/dev/null 2>&1 || die "node not found, install Node 18+ to pair"
  exec node "$BIN_DIR/bgos-pair.mjs" "$@"
}

# =============================================================================
# doctor, diagnose this host's HOAI agent setup. Hands off to bin/bgos-doctor.mjs
# (which does its own arg parsing), same shape as pair. Also reachable as `hoai
# doctor` via the bin/hoai dispatcher.
# =============================================================================
cmd_doctor() {
  if command -v node >/dev/null 2>&1; then
    exec node "$BIN_DIR/bgos-doctor.mjs" "$@"
  fi
  command -v bun >/dev/null 2>&1 || die "node (or bun) not found, install Node 18+ to run the doctor"
  exec bun "$BIN_DIR/bgos-doctor.mjs" "$@"
}

# =============================================================================
# arg parsing + dispatch
# =============================================================================
[ $# -ge 1 ] || { usage; exit 1; }
SUB="$1"; shift || true

# `pair` takes a positional CODE (and optional --backend); hand the whole tail to
# bgos-pair, which does its own arg parsing. Done before the flag loop below,
# which only understands install-style --flags.
if [ "$SUB" = "pair" ]; then
  cmd_pair "$@"
fi

# `doctor` likewise hands its whole tail to bgos-doctor.mjs.
if [ "$SUB" = "doctor" ]; then
  cmd_doctor "$@"
fi

# need_val <flag> <remaining-arg-count>, guards "shift 2" from aborting under
# set -e when a value-taking flag is the final token.
need_val() { [ "$2" -ge 2 ] || die "$1 requires a value"; }

while [ $# -gt 0 ]; do
  case "$1" in
    --assistant) need_val "$1" "$#"; ASSISTANT_ID="$2"; shift 2;;
    --key)       need_val "$1" "$#"; API_KEY="$2"; shift 2;;
    --user)      need_val "$1" "$#"; USER_ID="$2"; shift 2;;
    --openai-key) need_val "$1" "$#"; OPENAI_VOICE_KEY="$2"; shift 2;;
    --backend)   need_val "$1" "$#"; BACKEND="$2"; shift 2;;
    --dir)       need_val "$1" "$#"; WORKDIR="$2"; shift 2;;
    --channel)   need_val "$1" "$#"; CHANNEL="$2"; shift 2;;
    --auto-approve) need_val "$1" "$#"; AUTO_APPROVE="$2"; shift 2;;
    --always-on) ALWAYS_ON=1; shift;;
    --continue)  CONTINUE=1; shift;;
    --no-clone)  NO_CLONE=1; shift;;
    -h|--help)   usage; exit 0;;
    *) die "unknown option: $1 (try: hoai-agent help)";;
  esac
done

case "$SUB" in
  install)   cmd_install;;
  status)    cmd_status;;
  start)     cmd_start;;
  stop)      cmd_stop;;
  restart)   cmd_restart;;
  update)    cmd_update;;
  logs)      cmd_logs;;
  attach)    cmd_attach;;
  uninstall) cmd_uninstall;;
  is-installed) cmd_is_installed;;
  link)      cmd_link;;
  help|-h|--help) usage;;
  *) die "unknown command: $SUB (try: hoai-agent help)";;
esac
