{
  "name": "claude-channel-bgos",
  "version": "0.38.10",
  "description": "HOAI channel plugin for Claude Code, chat with Claude Code through the HOAI desktop and mobile app",
  "license": "Apache-2.0",
  "type": "module",
  "engines": {
    "node": ">=18"
  },
  "bin": {
    "claude-channel-bgos": "./server.ts",
    "bgos-claim": "./bin/bgos-claim.mjs",
    "hoai": "./bin/hoai-core.mjs",
    "hoai-agent": "./bin/bgos-agent",
    "hoai-pair": "./bin/bgos-pair.mjs",
    "bgos-agent": "./bin/bgos-agent",
    "bgos-pair": "./bin/bgos-pair.mjs"
  },
  "scripts": {
    "start": "bun install --no-summary 1>&2 && bun server.ts",
    "build": "tsc --noEmit",
    "test": "node scripts/run-tests.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.12.1",
    "socket.io-client": "^4.8.1",
    "zod": "^4.3.6"
  },
  "devDependencies": {
    "@types/bun": "^1.3.14",
    "@types/node": "^25.5.2",
    "tsx": "^4.21.0",
    "typescript": "^6.0.2"
  }
}
