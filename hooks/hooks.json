{
  "description": "HOAI: forwards this session's tool activity, task list and turn boundaries to the HOAI daemon so the owner sees live progress in the app; that forwarder is async, always exits 0 and never blocks a tool call. The hard floor hook blocks on purpose, which, only in a session a HOAI agent's daemon is attached to, asks the owner before a short list of risky actions (a recursive delete, a force push, a change inside .git, to an .env file or to a settings file in the home folder, a tool that sends, posts, pays or deletes), never denies, and fails open inside 2 seconds. A separate synchronous private-turn hook invalidates browser and schedule identity before each prompt and on turn end; if that boundary cannot be written it blocks the prompt to prevent reuse of another person's profile. The same hook records which turn started each helper agent and refuses a helper's browser, schedule or boards call outside that turn.",
  "hooks": {
    "SessionStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hoai-hook.mjs"],
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hoai-private-turn-hook.mjs"],
            "timeout": 5,
            "async": false
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hoai-hook.mjs"],
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hoai-hook.mjs"],
            "timeout": 5,
            "async": true
          }
        ]
      },
      {
        "matcher": "^(Bash|PowerShell|Write|Edit|MultiEdit|NotebookEdit|mcp__.*)$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hoai-floor-hook.mjs"],
            "timeout": 3,
            "async": false
          }
        ]
      },
      {
        "matcher": "^mcp__(.*_)?(hoai-browser__.+|bgos__(schedule|list_schedules|cancel_schedule|boards_.+|call_owner))$",
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hoai-private-turn-hook.mjs"],
            "timeout": 5,
            "async": false
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hoai-hook.mjs"],
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostToolUseFailure": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hoai-hook.mjs"],
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hoai-private-turn-hook.mjs"],
            "timeout": 5,
            "async": false
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hoai-hook.mjs"],
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SubagentStart": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hoai-private-turn-hook.mjs"],
            "timeout": 5,
            "async": false
          }
        ]
      }
    ],
    "SubagentStop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hoai-hook.mjs"],
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PreCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hoai-hook.mjs"],
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "PostCompact": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hoai-hook.mjs"],
            "timeout": 5,
            "async": true
          }
        ]
      }
    ],
    "SessionEnd": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hoai-private-turn-hook.mjs"],
            "timeout": 5,
            "async": false
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node",
            "args": ["${CLAUDE_PLUGIN_ROOT}/bin/hoai-hook.mjs"],
            "timeout": 5,
            "async": true
          }
        ]
      }
    ]
  }
}
